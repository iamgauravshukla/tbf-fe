---
// ============================================================================
// PRICE LIST  —  shareable client-facing treatment menu
//
// A standalone, unlisted page the team can share as a link
// (https://www.thebetterface.com/price-list/). Deliberately `noindex` and kept
// out of the sitemap/nav — see astro.config.mjs sitemap filter. To make it a
// public, indexed page: remove `noindex` below, drop the `/price-list` line
// from the sitemap filter, and link it from Header/Footer.
//
// >>> SINGLE SOURCE OF PRICES <<<  Update the arrays below and rebuild.
// Figures ported from "TBF Price List Client" (Vivere Hotel Alabang, Oct 2026).
// All prices in PHP.
// ============================================================================
import Base from '../layouts/Base.astro';
import { site, messengerLink, telLink } from '../site.config';

const peso = (n: number) => '₱' + n.toLocaleString('en-PH');

// ── Single treatments ─────────────────────────────────────────────────────
// regular = standard rate per session/area · promo = first-visit promo price
