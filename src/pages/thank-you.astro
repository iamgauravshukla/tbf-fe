---
// THE CONVERSION PAGE.
// generate_lead fires here, once, on a real page load after a successful POST.
// This is the event to mark as the GA4 key event and the Meta "Lead" standard
// event — not form_submit, which fires before the endpoint has accepted anything.
import Base from '../layouts/Base.astro';
import { site, telLink } from '../site.config';
import { fetchPosts } from '../lib/blog';

// Fetched at build time, fails soft (the section hides if the API is down).
const { posts } = await fetchPosts('?limit=2');
---
<Base
  title="Thank you | The Better Face"
  description="Your enquiry has been received. We reply within one working day."
  path="/thank-you/"
  noindex={true}
>
  <section class="section ty">
    <div class="wrap ty__in">
      <span class="eyebrow">Received</span>
      <h1>Thank you — we have your enquiry.</h1>
      <hr class="rule rule--center" />
      <p class="lede ty__p">
        Someone from the clinic will call or message you within one working day,
        during opening hours. If it is urgent, calling is faster than waiting.
      </p>
      <a href={telLink} class="btn btn--primary" data-ev="call_click" data-loc="thank_you">Call {site.phoneDisplay}</a>
      <p class="disclaimer ty__d">
        All treatments require a consultation. Results vary between individuals.
      </p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section--tight sunken">
      <div class="wrap">
        <h2 class="ty__h">While you wait</h2>
        <div class="grid g-2">
          {posts.map((p) => (
            <a href={`/journal/${p.slug}/`} class="jcard">
              <span class="micro">Journal</span>
              <h3 class="jcard__t">{p.title}</h3>
              <p class="jcard__d">{p.excerpt || p.metaDescription}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<script is:inline>
  // Fires on load, after the endpoint has accepted the submission and redirected
  // here. Guarded so a refresh or a back-button return does not double count.
  (function () {
    try {
      if (sessionStorage.getItem('tbf_lead')) return;
      sessionStorage.setItem('tbf_lead', '1');
    } catch (e) { /* private mode — fall through and fire once */ }
    if (window.gtag) window.gtag('event', 'generate_lead', { currency: 'PHP', value: 1 });
    if (window.fbq) window.fbq('track', 'Lead');
  })();
</script>

<style>
  .ty{text-align:center}
  .ty__in{max-width:40rem;margin-inline:auto}
  .ty__p{margin:0 auto var(--s4)}
  .ty__d{margin:var(--s3) auto 0}
  .ty__h{margin-bottom:var(--s3)}
  .jcard{display:block;padding:var(--s3);background:var(--surface-raised);border:1px solid var(--line);
    text-decoration:none;color:inherit;text-align:left;transition:border-color .2s}
  .jcard:hover{border-color:var(--champagne)}
  .jcard__t{font-family:'Playfair Display',serif;font-weight:400;font-size:1.25rem;color:var(--deep-teal);
    margin:.5rem 0 .4rem;line-height:1.25}
  .jcard__d{font-size:.8125rem;line-height:1.75;color:var(--text-muted)}
</style>
