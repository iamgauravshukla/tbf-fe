---
// Server-rendered per request from the API's database, so a post published in
// /admin/blog is live and crawlable immediately. Everything else on the site
// stays prerendered static.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import TreatmentCard from '../../components/TreatmentCard.astro';
import { site, waLink } from '../../site.config';
import { getEntry } from 'astro:content';
import { fetchPost, fetchPosts, renderMarkdown, fmtDate } from '../../lib/blog';

const slug = String(Astro.params.slug || '').replace(/\/$/, '');
const post = await fetchPost(slug);
if (!post) {
  // A real 404 status for crawlers (rewriting to the prerendered /404 page is
  // not supported from an on-demand route in standalone mode), with a gentle
  // human-facing bounce to the journal index.
  return new Response(
    `<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="0;url=/journal/"><title>Not found</title><a href="/journal/">Journal</a>`,
    { status: 404, headers: { 'Content-Type': 'text/html; charset=utf-8' } },
  );
}

const { html, toc } = renderMarkdown(post.content);

// "Read next": the most recent other post.
const { posts: latest } = await fetchPosts('?limit=4');
const next = latest.find((p) => p.slug !== post.slug) ?? null;

// Related treatments come from the post's `related` slugs — the internal link
// from education content to the commercial page.
const related = (
  await Promise.all((post.related || []).map((s) => Promise.resolve(getEntry('treatments', s)).catch(() => null)))
).filter(Boolean);

const pubDate = new Date(post.publishedAt);
// Only report a modified date that is real and not earlier than publication.
const modDate = post.updatedAt && new Date(post.updatedAt) > pubDate ? new Date(post.updatedAt) : undefined;
---
<Base
  title={post.seoTitle || post.title}
  description={post.metaDescription || post.excerpt}
  path={`/journal/${post.slug}/`}
  ogImage={post.coverImage || undefined}
  ogImageAlt={post.title}
  schemaType="article"
  article={{ title: post.title, description: post.metaDescription || post.excerpt, date: pubDate, modified: modDate }}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Journal', path: '/journal/' },
    { name: post.title, path: `/journal/${post.slug}/` },
  ]}
>
  <article>
    <!-- ══════════════ TITLE ══════════════ -->
    <header class="ahero">
      <div class="wrap ahero__in">
        <nav class="crumbs" aria-label="Breadcrumb" data-reveal>
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/journal/">Journal</a>
        </nav>
        <span class="eyebrow" data-reveal>Journal · {post.readMins} min read</span>
        <h1 class="ahero__h" data-reveal data-reveal-delay="1">{post.title}</h1>
        <hr class="rule rule--center" data-reveal data-reveal-delay="1" />
        <p class="lede ahero__lede" data-reveal data-reveal-delay="2">{post.excerpt || post.metaDescription}</p>
        <div class="byline" data-reveal data-reveal-delay="3">
          <time datetime={pubDate.toISOString()} class="byline__d">{fmtDate(post.publishedAt)}</time>
        </div>
      </div>
    </header>

    <!-- ══════════════ COVER (set in the editor) ══════════════ -->
    {post.coverImage && (
      <figure class="cover wrap" data-reveal>
        <img src={post.coverImage} alt={post.title} width="1200" height="675" fetchpriority="high" decoding="async" />
      </figure>
    )}

    <!-- ══════════════ BODY (auto table of contents from the h2s) ══════════════ -->
    <div class="section--tight">
      <div class="wrap abody">
        <aside class="toc">
          {toc.length > 1 && (
            <nav class="toc__in" aria-label="On this page">
              <span class="eyebrow">Contents</span>
              {toc.map((h) => <a href={`#${h.slug}`} class="toc__l">{h.text}</a>)}
            </nav>
          )}
        </aside>

        <div class="prose" data-reveal set:html={html} />

        <aside class="aside">
          <div class="aside__card" data-reveal data-reveal-delay="1">
            <span class="eyebrow">Book</span>
            <h2 class="aside__h">Ask us in person</h2>
            <p class="small">
              A consultation is the fastest way to find out whether any of this
              applies to you.
            </p>
            <a href="/contact/" class="btn btn--primary aside__btn" data-ev="book_click" data-loc="journal_aside">Book Free Consultation</a>
            <a href={waLink(`Hi ${site.name}, I read "${post.title}" and have a question.`)} class="aside__wa" data-ev="whatsapp_click" data-loc="journal_aside" rel="noopener">or ask on WhatsApp</a>
          </div>
        </aside>
      </div>
    </div>

    <!-- ══════════════ NEXT ══════════════ -->
    {next && (
      <div class="section--tight sunken">
        <div class="wrap author" data-reveal>
          <a href={`/journal/${next.slug}/`} class="nextup">
            <span class="eyebrow">Read next</span>
            <span class="nextup__t">{next.title}</span>
            <span class="nextup__m">Continue<i aria-hidden="true">→</i></span>
          </a>
        </div>
      </div>
    )}
  </article>

  <!-- ══════════════ RELATED TREATMENTS ══════════════ -->
  {related.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div>
            <span class="eyebrow">Mentioned above</span>
            <h2>Treatments in this article</h2>
          </div>
          <a href="/treatments/" class="sec-head__link">All treatments<i aria-hidden="true">→</i></a>
        </div>
        <div class="grid g-2 g-4 rel">
          {related.map((t: any, i: number) => (
            <div data-reveal data-reveal-delay={String(i)}>
              <TreatmentCard
                href={`/treatments/${t.id}/`}
                title={t.data.title}
                summary={t.data.summary}
                category={t.data.category}
                priceFrom={t.data.priceFrom}
                promoPrice={t.data.promoPrice}
                duration={t.data.duration}
                image={t.data.image}
                ratio="landscape"
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .crumbs{display:flex;flex-wrap:wrap;justify-content:center;gap:.5em;font-size:.5625rem;
    letter-spacing:.2em;text-transform:uppercase;font-weight:600;color:var(--text-muted);margin-bottom:var(--s4)}
  .crumbs a{color:var(--text-muted);text-decoration:none}
  .crumbs a:hover{color:var(--deep-teal);text-decoration:underline}

  /* ---------------- TITLE ---------------- */
  .ahero{background:var(--surface-raised);border-bottom:1px solid var(--line);
    padding-block:clamp(var(--s6),8vw,var(--s8))}
  .ahero__in{max-width:44rem;margin-inline:auto;text-align:center}
  .ahero__h{font-size:clamp(2.1rem,1.3rem + 2.8vw,3.4rem);margin-top:.8rem}
  .ahero__lede{margin-inline:auto}
  .byline{display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;
    gap:.6em var(--s3);margin-top:var(--s5)}
  .byline__d{font-size:.5625rem;letter-spacing:.2em;text-transform:uppercase;font-weight:600;
    color:var(--champagne)}

  /* ---------------- BODY ---------------- */
  /* Natural proportions; only a very tall image is trimmed to keep the text in reach. */
  .cover{margin:var(--s5) auto 0;max-width:1100px}
  .cover img{display:block;width:100%;height:auto;max-height:min(70vh,620px);object-fit:cover;background:var(--light-teal)}
  .abody{display:grid;gap:var(--s5)}
  @media (min-width:1100px){
    .abody{grid-template-columns:200px minmax(0,1fr) 300px;gap:var(--s5);align-items:start}
  }
  .toc{display:none}
  @media (min-width:1100px){ .toc{display:block;position:sticky;top:104px} }
  .toc__l{display:block;margin-top:.85rem;font-size:.75rem;line-height:1.5;
    color:var(--text-muted);text-decoration:none;padding-left:.9rem;border-left:1px solid var(--line)}
  .toc__l:hover{color:var(--deep-teal);border-left-color:var(--accent)}

  .prose{max-width:68ch;margin-inline:auto}
  .prose :global(> p:first-of-type){font-size:1.125rem;line-height:1.75;color:#3C4A50}
  .prose :global(h2){font-size:clamp(1.5rem,1.2rem + .9vw,1.9rem);margin-top:var(--s5);
    margin-bottom:var(--s2);scroll-margin-top:110px}
  .prose :global(h2:first-child){margin-top:0}
  .prose :global(h3){margin-top:var(--s4);margin-bottom:.6rem;color:var(--deep-teal);scroll-margin-top:110px}
  .prose :global(p){margin-bottom:var(--s2);font-size:.9375rem;line-height:1.9}
  .prose :global(ul),.prose :global(ol){margin:0 0 var(--s2);padding-left:1.3rem}
  .prose :global(li){margin-bottom:.5rem;line-height:1.85}
  .prose :global(strong){color:var(--deep-teal);font-weight:600}
  .prose :global(a){color:var(--ocean-teal)}
  .prose :global(blockquote){border-left:2px solid var(--accent);padding-left:var(--s3);
    margin:var(--s4) 0;font-family:'Playfair Display',serif;font-style:italic;
    font-size:1.25rem;line-height:1.55;color:var(--deep-teal)}
  .prose :global(blockquote p){font-size:inherit;line-height:inherit;margin:0}

  .aside{display:grid;gap:var(--s3)}
  @media (min-width:1100px){ .aside{position:sticky;top:104px} }
  .aside__card{background:var(--surface-raised);padding:var(--s4) var(--s3);border-top:2px solid var(--accent)}
  .aside__h{font-size:1.35rem;margin:.6rem 0 .7rem}
  /* Standard button type; the card's slimmer padding leaves room for the label on one line. */
  .aside__btn{width:100%;margin-top:var(--s3);white-space:nowrap;padding-inline:1rem}
  .aside__wa{display:block;text-align:center;margin-top:var(--s2);font-size:.75rem;
    color:var(--text-muted);text-decoration:none}
  .aside__wa:hover{color:var(--deep-teal);text-decoration:underline}

  /* ---------------- AUTHOR / NEXT ---------------- */
  .author{display:grid;gap:var(--s5)}
  @media (min-width:800px){ .author{max-width:44rem} }

  .nextup{display:block;padding:var(--s4);background:var(--deep-teal);color:var(--ivory);text-decoration:none}
  .nextup .eyebrow{color:var(--champagne)}
  .nextup__t{display:block;font-family:'Playfair Display',serif;font-size:1.55rem;
    line-height:1.2;letter-spacing:-.018em;margin-top:.8rem}
  .nextup__m{display:inline-flex;align-items:center;gap:.6em;margin-top:var(--s3);
    padding-top:.9rem;border-top:1px solid rgba(201,166,107,.55);
    font-size:.625rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--champagne)}
  .nextup__m i{font-style:normal;transition:transform .35s cubic-bezier(.22,.61,.36,1)}
  .nextup:hover .nextup__m i{transform:translateX(5px)}

  /* ---------------- RELATED ---------------- */
  .sec-head{display:grid;gap:var(--s3);margin-bottom:var(--s5)}
  @media (min-width:900px){ .sec-head{grid-template-columns:1fr auto;gap:var(--s5);align-items:end} }
  .sec-head h2{margin-top:.7rem}
  .sec-head__link{
    display:inline-flex;align-items:center;gap:.7em;white-space:nowrap;
    font-size:.625rem;font-weight:700;letter-spacing:.24em;text-transform:uppercase;
    color:var(--ocean-teal);text-decoration:none;padding-bottom:.5rem;border-bottom:1px solid var(--accent)
  }
  .sec-head__link i{font-style:normal;transition:transform .35s cubic-bezier(.22,.61,.36,1)}
  .sec-head__link:hover i{transform:translateX(5px)}
  /* Compact: four across on desktop, landscape photos, smaller type. */
  .rel{gap:var(--s4) var(--s3)}
  .rel :global(.tc__title){font-size:1.15rem}
  .rel :global(.tc__sum){font-size:.75rem;-webkit-line-clamp:3;line-clamp:3;min-height:calc(3em * 1.8);max-height:calc(3em * 1.8)}
</style>
