---
import Admin from '../../layouts/Admin.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import AdminSkeleton from '../../components/admin/AdminSkeleton.astro';
import { site } from '../../site.config';

const STATUSES = ['new', 'contacted', 'booked', 'completed', 'cancelled', 'lost'];
---
<Admin title="Bookings">
  <div class="dash" hidden id="dash">
    <AdminNav active="bookings" heading="Bookings" />

    <main class="db-main">
      <section class="kpi" id="kpi" aria-label="Booking summary"></section>

      <section class="db-tools">
        <input class="db-search" id="search" type="search" placeholder="Search name, phone, email, treatment…" autocomplete="off" />
        <select class="db-sel" id="fStatus" aria-label="Status">
          <option value="">All statuses</option>
          {STATUSES.map((s) => <option value={s}>{s}</option>)}
        </select>
        <button class="db-btn db-btn--ghost" id="clearBtn" type="button">Clear</button>
      </section>

      <!-- bulk actions (admin only) -->
      <div class="db-bulk" id="bulk" hidden>
        <span class="db-bulk__n" id="bulkCount">0 selected</span>
        <button class="db-btn db-btn--danger" id="bulkDelete" type="button">Delete</button>
        <button class="db-btn db-btn--ghostdark" id="bulkClear" type="button">Clear</button>
      </div>

      <section class="bk-sec">
        <h2 class="bk-sec__h">Upcoming <span class="bk-sec__c" id="upCount"></span></h2>
        <div class="db-tablewrap">
          <table class="db-table bk-table">
            <thead>
              <tr><th class="db-checkcol" data-checkcol hidden></th><th>When</th><th>Name</th><th>Treatment</th><th>Contact</th><th>Age</th><th>Pre-medical</th><th>Status</th><th aria-label="Open"></th></tr>
            </thead>
            <tbody id="upRows"></tbody>
          </table>
          <p class="db-empty" id="upEmpty" hidden>No upcoming bookings.</p>
        </div>
      </section>

      <section class="bk-sec">
        <h2 class="bk-sec__h">Earlier &amp; closed <span class="bk-sec__c" id="pastCount"></span></h2>
        <div class="db-tablewrap">
          <table class="db-table bk-table">
            <thead>
              <tr><th class="db-checkcol" data-checkcol hidden></th><th>When</th><th>Name</th><th>Treatment</th><th>Contact</th><th>Age</th><th>Pre-medical</th><th>Status</th><th aria-label="Open"></th></tr>
            </thead>
            <tbody id="pastRows"></tbody>
          </table>
          <p class="db-empty" id="pastEmpty" hidden>Nothing here yet.</p>
        </div>
      </section>
    </main>
  </div>

  <AdminSkeleton />

  <script define:vars={{ apiBase: site.apiBase, STATUSES }}>
    const TOKEN = localStorage.getItem('tbf_token');
    if (!TOKEN) location.replace('/admin/login/');
    let ME = {}; try { ME = JSON.parse(localStorage.getItem('tbf_user') || '{}'); } catch (_) {}
    const isAdmin = ME.role === 'admin';
    const picked = new Set();

    const STATUS_LABEL = { new:'Pending', contacted:'Contacted', booked:'Confirmed', completed:'Completed', cancelled:'Cancelled', lost:'Lost' };
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    const fmtWhen = (iso) => { if (!iso) return '—'; return new Date(iso).toLocaleString('en-GB', { weekday:'short', day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }); };

    const state = { q: '', status: '' };
    let bookings = [];

    async function api(path, opts = {}) {
      const res = await fetch(apiBase + path, {
        ...opts,
        headers: { 'authorization': 'Bearer ' + TOKEN, ...(opts.body ? { 'content-type':'application/json' } : {}), ...(opts.headers||{}) },
      });
      if (res.status === 401) { localStorage.removeItem('tbf_token'); location.replace('/admin/login/'); throw new Error('unauth'); }
      if (window.tbfSynced) window.tbfSynced();
      return res.json();
    }

    function statusSelect(status, id) {
      const opts = STATUSES.map((s) => `<option value="${s}" ${s===status?'selected':''}>${STATUS_LABEL[s]}</option>`).join('');
      return `<select class="db-status db-status--${esc(status)}" data-status-id="${esc(id)}">${opts}</select>`;
    }

    function rowHTML(b) {
      const med = b.preMedical
        ? `<details class="bk-med"><summary>⚠︎ Notes</summary><p>${esc(b.preMedical)}</p></details>`
        : '<span class="db-muted">—</span>';
      const contact = `<a href="tel:${esc(b.phone)}">${esc(b.phone)}</a>${b.email?`<span class="db-sub"><a href="mailto:${esc(b.email)}">${esc(b.email)}</a></span>`:''}`;
      const pending = b.status === 'new' ? '<span class="bk-badge">Pending</span>' : '';
      return `<tr data-id="${esc(b.id)}">
        ${isAdmin ? `<td class="db-checkcol"><input type="checkbox" class="db-check" data-pick="${esc(b.id)}" ${picked.has(b.id) ? 'checked' : ''} aria-label="Select ${esc(b.name)}" /></td>` : ''}
        <td class="db-nowrap"><strong>${fmtWhen(b.appointmentAt)}</strong>${pending}</td>
        <td><strong>${esc(b.name)}</strong></td>
        <td>${esc(b.treatment || '—')}</td>
        <td>${contact}</td>
        <td>${b.age ? esc(b.age) : '—'}</td>
        <td>${med}</td>
        <td>${statusSelect(b.status, b.id)}${b.status==='new'?`<button class="db-btn db-btn--solid bk-confirm" data-confirm="${esc(b.id)}">Confirm</button>`:''}</td>
        <td><a class="db-link" href="/admin/?lead=${esc(b.id)}">Open</a></td>
      </tr>`;
    }

    function matches(b) {
      if (state.status && b.status !== state.status) return false;
      if (state.q) {
        const s = state.q.toLowerCase();
        if (![b.name, b.email, b.phone, b.treatment].some((f) => (f||'').toLowerCase().includes(s))) return false;
      }
      return true;
    }

    function render() {
      const now = Date.now();
      const closed = new Set(['cancelled', 'lost', 'completed']);
      const list = bookings.filter(matches);
      const upcoming = list.filter((b) => b.appointmentAt && new Date(b.appointmentAt).getTime() >= now && !closed.has(b.status))
        .sort((a, b) => new Date(a.appointmentAt) - new Date(b.appointmentAt));
      const past = list.filter((b) => !(b.appointmentAt && new Date(b.appointmentAt).getTime() >= now && !closed.has(b.status)))
        .sort((a, b) => new Date(b.appointmentAt || b.receivedAt) - new Date(a.appointmentAt || a.receivedAt));

      $('upRows').innerHTML = upcoming.map(rowHTML).join('');
      $('pastRows').innerHTML = past.map(rowHTML).join('');
      $('upEmpty').hidden = upcoming.length > 0;
      $('pastEmpty').hidden = past.length > 0;
      $('upCount').textContent = upcoming.length ? `(${upcoming.length})` : '';
      $('pastCount').textContent = past.length ? `(${past.length})` : '';
      wire();
    }

    function wire() {
      document.querySelectorAll('.db-status').forEach((sel) =>
        sel.addEventListener('change', () => setStatus(sel.dataset.statusId, sel.value)));
      document.querySelectorAll('[data-confirm]').forEach((b) =>
        b.addEventListener('click', () => setStatus(b.dataset.confirm, 'booked')));
      if (isAdmin) {
        document.querySelectorAll('.db-check').forEach((c) =>
          c.addEventListener('change', () => { c.checked ? picked.add(c.dataset.pick) : picked.delete(c.dataset.pick); updateBulk(); }));
      }
      updateBulk();
    }

    function updateBulk() {
      if (!isAdmin) return;
      const bar = $('bulk');
      if (bar) bar.hidden = picked.size === 0;
      if ($('bulkCount')) $('bulkCount').textContent = picked.size + ' selected';
    }
    async function bulkDelete() {
      if (!picked.size) return;
      if (!confirm(`Permanently delete ${picked.size} booking(s)? This removes the record and its history. This cannot be undone.`)) return;
      const j = await api('/api/admin/leads/delete', { method: 'POST', body: JSON.stringify({ ids: [...picked] }) });
      if (j.ok) { bookings = bookings.filter((b) => !picked.has(b.id)); picked.clear(); renderKpi(); render(); updateBulk(); }
      else { alert(j.error === 'forbidden' ? 'Only an admin can delete records.' : 'Could not delete.'); }
    }

    async function setStatus(id, status) {
      const j = await api('/api/admin/leads/' + id, { method:'PATCH', body: JSON.stringify({ status }) });
      if (j.ok) { const i = bookings.findIndex((b) => b.id === id); if (i>-1) bookings[i] = j.lead; render(); renderKpi(); }
      else { alert('Could not update the booking.'); }
    }

    function renderKpi() {
      const now = Date.now();
      const midnight = new Date(); midnight.setHours(0,0,0,0);
      const pending = bookings.filter((b) => b.status === 'new').length;
      const upcoming = bookings.filter((b) => b.appointmentAt && new Date(b.appointmentAt).getTime() >= now && !['cancelled','lost','completed'].includes(b.status)).length;
      const today = bookings.filter((b) => b.appointmentAt && new Date(b.appointmentAt).toDateString() === new Date().toDateString()).length;
      const tiles = [
        { k:'Upcoming', v: upcoming },
        { k:'Today', v: today },
        { k:'Pending confirm', v: pending },
        { k:'Total', v: bookings.length },
      ];
      $('kpi').innerHTML = tiles.map((t) => `<div class="kpi__i" ${pending && t.k==='Pending confirm' ? 'data-warn' : ''}><span class="kpi__v">${t.v}</span><span class="kpi__k">${t.k}</span></div>`).join('');
    }

    async function load() {
      const j = await api('/api/admin/leads?source=booking&limit=500');
      if (!j.ok) return;
      bookings = j.leads || [];
      picked.clear();
      renderKpi();
      render();
    }

    // filters
    let t;
    $('search').addEventListener('input', (e) => { clearTimeout(t); t = setTimeout(() => { state.q = e.target.value.trim(); render(); }, 250); });
    $('fStatus').addEventListener('change', (e) => { state.status = e.target.value; render(); });
    $('clearBtn').addEventListener('click', () => { state.q=''; state.status=''; $('search').value=''; $('fStatus').value=''; render(); });
    if ($('refreshBtn')) $('refreshBtn').addEventListener('click', load);
    if ($('logoutBtn')) $('logoutBtn').addEventListener('click', () => { localStorage.removeItem('tbf_token'); localStorage.removeItem('tbf_user'); location.replace('/admin/login/'); });
    if ($('userInfo')) $('userInfo').textContent = ME.name ? `${ME.name} · ${ME.role}` : (ME.email || '');

    if (isAdmin) {
      document.querySelectorAll('[data-checkcol]').forEach((el) => (el.hidden = false));
      if ($('bulkDelete')) $('bulkDelete').addEventListener('click', bulkDelete);
      if ($('bulkClear')) $('bulkClear').addEventListener('click', () => { picked.clear(); document.querySelectorAll('.db-check').forEach((c) => (c.checked = false)); updateBulk(); });
    }

    (async () => {
      try {
        await load();
        $('loading').hidden = true; $('dash').hidden = false;
      } catch (e) {
        if (e.message !== 'unauth') $('loading').textContent = 'Could not reach the API. Is the server running?';
      }
    })();
  </script>

  <style>
    .bk-sec { margin-top: var(--s4); }
    .bk-sec__h { font-family: 'Playfair Display', serif; font-weight: 500; font-size: 1.25rem; color: var(--deep-teal); margin-bottom: var(--s2); }
    .bk-sec__c { color: var(--text-muted); font-size: .9rem; font-family: 'Instrument Sans', sans-serif; }
    .bk-badge { display: inline-block; margin-left: .5rem; font-size: .5625rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 700; color: #8A5A2B; background: #FBF3E7; padding: .1rem .4rem; border-radius: 2px; vertical-align: middle; }
    .bk-confirm { margin-left: .4rem; padding: .25rem .6rem; min-height: 0; font-size: .6875rem; }
    .bk-med > summary { cursor: pointer; font-size: .75rem; color: #8A5A2B; list-style: none; }
    .bk-med > summary::-webkit-details-marker { display: none; }
    .bk-med[open] > summary { color: var(--text-muted); }
    .bk-med p { margin: .3rem 0 0; font-size: .75rem; line-height: 1.5; color: var(--text); max-width: 32ch; }
  </style>
</Admin>
