---
import Admin from '../../layouts/Admin.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import { site } from '../../site.config';
import { getCollection } from 'astro:content';

// Treatment names for the filter dropdown; statuses mirror the API.
const treatmentNames = (await getCollection('treatments', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => t.data.title);
const STATUSES = ['new', 'contacted', 'booked', 'completed', 'cancelled', 'lost'];
---
<Admin title="Leads">
  <div class="dash" hidden id="dash">
    <AdminNav active="leads" heading="Enquiries" />

    <main class="db-main">
      <!-- KPI row -->
      <section class="kpi" id="kpi" aria-label="Summary"></section>

      <!-- pipeline flow -->
      <section class="pipe" id="pipe" aria-label="Pipeline flow"></section>

      <!-- toolbar: filters + view toggle -->
      <section class="db-tools">
        <input class="db-search" id="search" type="search" placeholder="Search name, email, phone, treatment, notes…" autocomplete="off" />
        <select class="db-sel" id="fStatus" aria-label="Status" hidden>
          <option value="">All statuses</option>
          {STATUSES.map((s) => <option value={s}>{s}</option>)}
        </select>
        <select class="db-sel" id="fAssignee" aria-label="Owner">
          <option value="">All owners</option>
          <option value="mine">My leads</option>
          <option value="none">Unassigned</option>
        </select>
        <select class="db-sel" id="fTreatment" aria-label="Treatment">
          <option value="">All treatments</option>
          {treatmentNames.map((t) => <option value={t}>{t}</option>)}
        </select>
        <label class="db-date">From<input id="fFrom" type="date" /></label>
        <label class="db-date">To<input id="fTo" type="date" /></label>
        <button class="db-btn db-btn--ghost" id="clearBtn" type="button">Clear</button>
        <div class="db-viewtoggle" role="group" aria-label="View">
          <button class="db-vt is-on" id="viewBoard" type="button">Board</button>
          <button class="db-vt" id="viewTable" type="button">Table</button>
        </div>
      </section>

      <!-- BOARD (kanban) -->
      <section class="kb" id="board" aria-label="Lead board"></section>

      <!-- TABLE -->
      <section class="db-tablewrap" id="tableWrap" hidden>
        <table class="db-table">
          <thead>
            <tr>
              <th>Received</th><th>Name</th><th>Phone</th><th>Treatment</th>
              <th>Owner</th><th>Source</th><th>Status</th><th aria-label="Details"></th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
        <p class="db-empty" id="empty" hidden>No enquiries match these filters.</p>
      </section>
      <footer class="db-page" id="pager" hidden>
        <span id="pageInfo"></span>
        <div class="db-page__btns">
          <button class="db-btn db-btn--ghost" id="prevBtn" type="button">Previous</button>
          <button class="db-btn db-btn--ghost" id="nextBtn" type="button">Next</button>
        </div>
      </footer>
    </main>

    <!-- detail drawer -->
    <div class="db-drawer" id="drawer" hidden>
      <div class="db-drawer__scrim" id="scrim"></div>
      <aside class="db-drawer__panel" role="dialog" aria-label="Enquiry detail">
        <button class="db-drawer__close" id="closeDrawer" type="button" aria-label="Close">&times;</button>
        <div id="detail"></div>
      </aside>
    </div>
  </div>

  <p class="db-loading" id="loading">Loading…</p>

  <script define:vars={{ apiBase: site.apiBase, STATUSES }}>
    const TOKEN = localStorage.getItem('tbf_token');
    if (!TOKEN) location.replace('/admin/login');
    let ME = {};
    try { ME = JSON.parse(localStorage.getItem('tbf_user') || '{}'); } catch (_) {}

    const STATUS_LABEL = { new:'New', contacted:'Contacted', booked:'Booked', completed:'Completed', cancelled:'Cancelled', lost:'Lost' };
    const FLOW = ['new', 'contacted', 'booked', 'completed'];

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    const fmtDate = (iso) => { if (!iso) return '—'; const d = new Date(iso); return d.toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }); };
    const fmtDay = (iso) => { if (!iso) return '—'; return new Date(iso).toLocaleDateString('en-GB', { day:'2-digit', month:'short' }); };
    const toLocalInput = (iso) => iso ? new Date(new Date(iso).getTime() - new Date().getTimezoneOffset()*60000).toISOString().slice(0,16) : '';

    let savedView = 'board';
    try { savedView = localStorage.getItem('tbf_view') || 'board'; } catch (_) {}
    const state = { q:'', status:'', assignedTo:'', treatment:'', from:'', to:'', limit:25, offset:0, total:0, view: savedView };
    let leads = [];
    let AGENTS = [];
    let ASSIGNABLE = [];
    const agentName = (id) => { const a = AGENTS.find((x) => x.id === id); return a ? a.name : (id ? 'Unknown' : ''); };

    async function api(path, opts = {}) {
      const res = await fetch(apiBase + path, {
        ...opts,
        headers: { 'authorization': 'Bearer ' + TOKEN, ...(opts.body ? { 'content-type':'application/json' } : {}), ...(opts.headers||{}) },
      });
      if (res.status === 401) { localStorage.removeItem('tbf_token'); location.replace('/admin/login'); throw new Error('unauth'); }
      return res.json();
    }

    // ── owner + status controls (table) ──
    function ownerOptions(selected) {
      const opts = [`<option value="" ${!selected?'selected':''}>Unassigned</option>`];
      for (const a of ASSIGNABLE) opts.push(`<option value="${esc(a.id)}" ${a.id===selected?'selected':''}>${esc(a.name)}</option>`);
      if (selected && !ASSIGNABLE.some((a) => a.id === selected)) opts.push(`<option value="${esc(selected)}" selected>${esc(agentName(selected))}</option>`);
      return opts.join('');
    }
    function statusPill(status, id) {
      const opts = STATUSES.map((s) => `<option value="${s}" ${s===status?'selected':''}>${STATUS_LABEL[s]}</option>`).join('');
      return `<select class="db-status db-status--${esc(status)}" data-status-id="${esc(id)}">${opts}</select>`;
    }

    // ── KPI + pipeline flow (from stats) ──
    function renderPipe(s) {
      const kpis = [
        { k:'Today', v:s.today }, { k:'This week', v:s.week }, { k:'Total', v:s.total },
        { k:'Unassigned', v:s.unassigned, assignee:'none' },
      ];
      $('kpi').innerHTML = kpis.map((t) =>
        `<button class="kpi__i ${t.assignee?'is-clickable':''}" ${t.assignee?`data-assignee="${t.assignee}"`:'disabled'}>
          <span class="kpi__v">${t.v}</span><span class="kpi__k">${t.k}</span></button>`).join('');
      $('kpi').querySelectorAll('[data-assignee]').forEach((el) =>
        el.addEventListener('click', () => { state.assignedTo = el.dataset.assignee; $('fAssignee').value = 'none'; reload(); }));

      const stage = (st) => `<button class="pipe__stage pipe__stage--${st}" data-status="${st}">
          <span class="pipe__v">${s.byStatus[st] || 0}</span><span class="pipe__k">${STATUS_LABEL[st]}</span></button>`;
      const flow = FLOW.map((st, i) => stage(st) + (i < FLOW.length - 1 ? '<span class="pipe__arrow" aria-hidden="true">›</span>' : '')).join('');
      const closed = ['cancelled', 'lost'].map((st) => `<button class="pipe__stage pipe__stage--${st} is-muted" data-status="${st}">
          <span class="pipe__v">${s.byStatus[st] || 0}</span><span class="pipe__k">${STATUS_LABEL[st]}</span></button>`).join('');
      $('pipe').innerHTML = `<div class="pipe__flow">${flow}</div><div class="pipe__closed">${closed}</div>`;
      $('pipe').querySelectorAll('[data-status]').forEach((el) =>
        el.addEventListener('click', () => { state.status = el.dataset.status; $('fStatus').value = state.status; setView('table'); }));
    }

    // ── kanban board ──
    function cardHTML(l) {
      return `<article class="kb-card" draggable="true" data-id="${esc(l.id)}">
        <div class="kb-card__name">${esc(l.name)}</div>
        <div class="kb-card__treat">${esc(l.treatment || '—')}</div>
        <div class="kb-card__meta">
          <span class="kb-owner ${l.assignedTo?'':'is-none'}">${l.assignedTo ? esc(agentName(l.assignedTo)) : 'Unassigned'}</span>
          <span class="kb-time">${fmtDay(l.receivedAt)}</span>
        </div>
        ${l.appointmentAt ? `<div class="kb-appt">Appt · ${fmtDate(l.appointmentAt)}</div>` : ''}
      </article>`;
    }
    function renderBoard() {
      const groups = Object.fromEntries(STATUSES.map((s) => [s, []]));
      for (const l of leads) if (groups[l.status]) groups[l.status].push(l);
      $('board').innerHTML = STATUSES.map((s) => `
        <div class="kb-col kb-col--${s}">
          <div class="kb-col__head"><span class="kb-col__dot"></span>${STATUS_LABEL[s]}<span class="kb-col__count">${groups[s].length}</span></div>
          <div class="kb-col__body" data-status="${s}">
            ${groups[s].map(cardHTML).join('') || '<p class="kb-empty">Drop here</p>'}
          </div>
        </div>`).join('');
      wireBoard();
    }
    function wireBoard() {
      const board = $('board');
      board.querySelectorAll('.kb-card').forEach((card) => {
        card.addEventListener('dragstart', (e) => { e.dataTransfer.setData('text/plain', card.dataset.id); e.dataTransfer.effectAllowed = 'move'; card.classList.add('is-dragging'); });
        card.addEventListener('dragend', () => card.classList.remove('is-dragging'));
        card.addEventListener('click', () => openDetail(card.dataset.id));
      });
      board.querySelectorAll('.kb-col__body').forEach((body) => {
        body.addEventListener('dragover', (e) => { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; body.classList.add('is-over'); });
        body.addEventListener('dragleave', () => body.classList.remove('is-over'));
        body.addEventListener('drop', (e) => {
          e.preventDefault(); body.classList.remove('is-over');
          const id = e.dataTransfer.getData('text/plain');
          const lead = leads.find((l) => l.id === id);
          if (lead && lead.status !== body.dataset.status) moveLead(id, body.dataset.status);
        });
      });
    }
    async function moveLead(id, status) {
      const lead = leads.find((l) => l.id === id); if (!lead) return;
      const prev = lead.status;
      lead.status = status; renderBoard();                    // optimistic
      const j = await api('/api/admin/leads/' + id, { method:'PATCH', body: JSON.stringify({ status }) });
      if (j.ok) { const i = leads.findIndex((l) => l.id === id); if (i > -1) leads[i] = j.lead; renderBoard(); loadStats(); }
      else { lead.status = prev; renderBoard(); alert('Could not move the lead.'); }
    }

    // ── table ──
    function renderRows() {
      const tb = $('rows');
      if (!leads.length) { tb.innerHTML = ''; $('empty').hidden = false; return; }
      $('empty').hidden = true;
      tb.innerHTML = leads.map((l) => `
        <tr data-id="${esc(l.id)}">
          <td class="db-nowrap">${fmtDate(l.receivedAt)}</td>
          <td><strong>${esc(l.name)}</strong>${l.appointmentAt?`<span class="db-appt">appt ${fmtDay(l.appointmentAt)}</span>`:''}${l.email?`<span class="db-sub"><a href="mailto:${esc(l.email)}">${esc(l.email)}</a></span>`:''}</td>
          <td><a href="tel:${esc(l.phone)}">${esc(l.phone)}</a></td>
          <td>${esc(l.treatment)}</td>
          <td><select class="db-owner" data-assign="${esc(l.id)}">${ownerOptions(l.assignedTo)}</select></td>
          <td class="db-muted">${esc(l.source)}</td>
          <td>${statusPill(l.status, l.id)}</td>
          <td><button class="db-link" data-detail="${esc(l.id)}">Details</button></td>
        </tr>`).join('');
      tb.querySelectorAll('.db-status').forEach((sel) =>
        sel.addEventListener('change', (e) => { e.stopPropagation(); setLead(sel.dataset.statusId, { status: sel.value }); }));
      tb.querySelectorAll('.db-owner').forEach((sel) =>
        sel.addEventListener('change', (e) => { e.stopPropagation(); setLead(sel.dataset.assign, { assignedTo: sel.value }); }));
      tb.querySelectorAll('[data-detail]').forEach((b) =>
        b.addEventListener('click', () => openDetail(b.dataset.detail)));
    }

    const renderActive = () => (state.view === 'board' ? renderBoard() : renderRows());

    async function setLead(id, patch) {
      const j = await api('/api/admin/leads/' + id, { method:'PATCH', body: JSON.stringify(patch) });
      if (j.ok) { const i = leads.findIndex((l) => l.id === id); if (i>-1) leads[i] = j.lead; loadStats(); renderActive(); }
      else { alert(j.error === 'forbidden' ? 'You can only assign leads to yourself.' : 'Could not save.'); reloadView(); }
    }

    // ── detail drawer ──
    function renderActivity(items) {
      if (!items || !items.length) return '<p class="db-tl__empty">No activity yet.</p>';
      return '<ul class="db-tl">' + items.map((a) => `
        <li class="db-tl__i db-tl__i--${esc(a.type)}">
          <span class="db-tl__dot"></span>
          <div><p class="db-tl__msg">${esc(a.message)}</p>
          <span class="db-tl__meta">${esc(a.actorName)} · ${fmtDate(a.at)}</span></div>
        </li>`).join('') + '</ul>';
    }
    function renderTaskList(items) {
      if (!items || !items.length) return '<p class="db-tl__empty">No tasks yet.</p>';
      const overdue = (t) => !t.done && t.dueAt && new Date(t.dueAt) < new Date();
      return '<ul class="db-tasks">' + items.map((t) => `
        <li class="db-task ${t.done?'is-done':''} ${overdue(t)?'is-overdue':''}">
          <label><input type="checkbox" data-task="${esc(t.id)}" ${t.done?'checked':''}>
          <span class="db-task__t">${esc(t.title)}</span></label>
          <span class="db-task__due">${t.dueAt?fmtDate(t.dueAt):'No date'}${t.assignedTo&&t.assignedTo!==ME.id?' · '+esc(agentName(t.assignedTo)):''}</span>
        </li>`).join('') + '</ul>';
    }

    async function openDetail(id) {
      const l = leads.find((x) => x.id === id); if (!l) return;
      $('detail').innerHTML = `
        <span class="eyebrow">Enquiry</span>
        <h2 class="db-dh">${esc(l.name)}</h2>
        <dl class="db-dl">
          <div><dt>Phone</dt><dd><a href="tel:${esc(l.phone)}">${esc(l.phone)}</a></dd></div>
          ${l.email?`<div><dt>Email</dt><dd><a href="mailto:${esc(l.email)}">${esc(l.email)}</a></dd></div>`:''}
          <div><dt>Treatment</dt><dd>${esc(l.treatment)}</dd></div>
          <div><dt>Source</dt><dd>${esc(l.source)}</dd></div>
          <div><dt>Received</dt><dd>${fmtDate(l.receivedAt)}</dd></div>
          ${l.message?`<div class="db-dl__wide"><dt>Message</dt><dd>${esc(l.message)}</dd></div>`:''}
        </dl>

        <div class="db-drow">
          <label class="db-flabel">Owner
            <select id="dOwner" class="db-sel">${ownerOptions(l.assignedTo)}</select>
          </label>
          <label class="db-flabel">Status
            <select id="dStatus" class="db-sel">${STATUSES.map((s)=>`<option value="${s}" ${s===l.status?'selected':''}>${STATUS_LABEL[s]}</option>`).join('')}</select>
          </label>
        </div>
        <label class="db-flabel">Appointment
          <input id="dAppt" type="datetime-local" class="db-sel" value="${toLocalInput(l.appointmentAt)}">
        </label>
        <label class="db-flabel">Notes
          <textarea id="dNotes" class="db-textarea" rows="3" placeholder="Summary, next step…">${esc(l.notes||'')}</textarea>
        </label>
        <button class="btn btn--primary db-save" id="dSave" type="button">Save changes</button>
        <p class="db-saved" id="dSaved" hidden>Saved.</p>

        <section class="db-dsec">
          <h3 class="db-dsec__h">Log activity</h3>
          <div class="db-actform">
            <select id="aType" class="db-sel">
              <option value="call">Call</option>
              <option value="note">Note</option>
              <option value="message">Message</option>
            </select>
            <input id="aMsg" class="db-sel" placeholder="Outcome or note…" />
            <button class="db-btn db-btn--solid" id="aLog" type="button">Log</button>
          </div>
          <div id="timeline">${renderActivity(null)}</div>
        </section>

        <section class="db-dsec">
          <h3 class="db-dsec__h">Follow-up tasks</h3>
          <div class="db-actform">
            <input id="tTitle" class="db-sel" placeholder="e.g. Call back tomorrow" />
            <input id="tDue" type="datetime-local" class="db-sel" />
            <button class="db-btn db-btn--solid" id="tAdd" type="button">Add</button>
          </div>
          <div id="leadTasks">${renderTaskList(null)}</div>
        </section>`;
      $('drawer').hidden = false;

      const refreshTimeline = async () => { const j = await api('/api/admin/leads/'+id+'/activity'); if (j.ok) $('timeline').innerHTML = renderActivity(j.activity); };
      const refreshTasks = async () => { const j = await api('/api/tasks?leadId='+id); if (j.ok) { $('leadTasks').innerHTML = renderTaskList(j.tasks); wireTaskChecks(); } };
      const wireTaskChecks = () => $('leadTasks').querySelectorAll('[data-task]').forEach((c) =>
        c.addEventListener('change', async () => { await api('/api/tasks/'+c.dataset.task, { method:'PATCH', body: JSON.stringify({ done: c.checked }) }); refreshTasks(); }));
      refreshTimeline(); refreshTasks();

      $('dSave').addEventListener('click', async () => {
        const appt = $('dAppt').value ? new Date($('dAppt').value).toISOString() : null;
        const j = await api('/api/admin/leads/' + id, { method:'PATCH', body: JSON.stringify({ status: $('dStatus').value, assignedTo: $('dOwner').value, notes: $('dNotes').value, appointmentAt: appt }) });
        if (j.ok) { const i = leads.findIndex((x)=>x.id===id); if (i>-1) leads[i]=j.lead; renderActive(); loadStats(); refreshTimeline(); $('dSaved').hidden=false; setTimeout(()=>{$('dSaved').hidden=true;},1500); }
        else { alert(j.error === 'forbidden' ? 'You can only assign leads to yourself.' : 'Could not save.'); }
      });
      $('aLog').addEventListener('click', async () => {
        const message = $('aMsg').value.trim(); if (!message) return;
        const j = await api('/api/admin/leads/'+id+'/activity', { method:'POST', body: JSON.stringify({ type: $('aType').value, message }) });
        if (j.ok) { $('aMsg').value=''; refreshTimeline(); }
      });
      $('tAdd').addEventListener('click', async () => {
        const title = $('tTitle').value.trim(); if (!title) return;
        const dueAt = $('tDue').value ? new Date($('tDue').value).toISOString() : null;
        const j = await api('/api/tasks', { method:'POST', body: JSON.stringify({ title, leadId: id, dueAt }) });
        if (j.ok) { $('tTitle').value=''; $('tDue').value=''; refreshTasks(); refreshTimeline(); }
      });
    }
    function closeDrawer(){ $('drawer').hidden = true; }

    // ── data loading ──
    async function loadStats() { const j = await api('/api/admin/stats'); if (j.ok) renderPipe(j); }

    async function loadBoard() {
      const p = new URLSearchParams();
      for (const k of ['q','assignedTo','treatment','from','to']) if (state[k]) p.set(k, state[k]);
      p.set('limit', '300');
      const j = await api('/api/admin/leads?' + p.toString());
      if (!j.ok) return;
      leads = j.leads;
      renderBoard();
    }

    async function loadLeads() {
      const p = new URLSearchParams();
      for (const k of ['q','status','assignedTo','treatment','from','to']) if (state[k]) p.set(k, state[k]);
      p.set('limit', state.limit); p.set('offset', state.offset);
      const j = await api('/api/admin/leads?' + p.toString());
      if (!j.ok) return;
      leads = j.leads; state.total = j.total;
      renderRows();
      const start = state.total ? state.offset + 1 : 0;
      const end = Math.min(state.offset + state.limit, state.total);
      $('pageInfo').textContent = `${start}–${end} of ${state.total}`;
      $('prevBtn').disabled = state.offset <= 0;
      $('nextBtn').disabled = end >= state.total;
    }

    const reloadView = () => (state.view === 'board' ? loadBoard() : loadLeads());
    async function reload() { await Promise.all([loadStats(), reloadView()]); }

    function setView(v) {
      state.view = v;
      try { localStorage.setItem('tbf_view', v); } catch (_) {}
      $('viewBoard').classList.toggle('is-on', v === 'board');
      $('viewTable').classList.toggle('is-on', v === 'table');
      $('board').hidden = v !== 'board';
      $('tableWrap').hidden = v !== 'table';
      $('pager').hidden = v !== 'table';
      $('fStatus').hidden = v !== 'table';
      reloadView();
    }

    async function loadAgents() {
      const j = await api('/api/admin/agents');
      AGENTS = (j.ok && j.agents) ? j.agents : [];
      ASSIGNABLE = ME.role === 'agent' ? AGENTS.filter((a) => a.id === ME.id) : AGENTS;
      const sel = $('fAssignee');
      for (const a of AGENTS) { const o = document.createElement('option'); o.value = a.id; o.textContent = a.name; sel.appendChild(o); }
    }

    // ── wiring ──
    let t;
    $('search').addEventListener('input', (e) => { clearTimeout(t); t = setTimeout(() => { state.q = e.target.value.trim(); state.offset = 0; reloadView(); }, 300); });
    $('fStatus').addEventListener('change', (e) => { state.status = e.target.value; state.offset = 0; loadLeads(); });
    $('fAssignee').addEventListener('change', (e) => { state.assignedTo = e.target.value; state.offset = 0; reload(); });
    $('fTreatment').addEventListener('change', (e) => { state.treatment = e.target.value; state.offset = 0; reloadView(); });
    $('fFrom').addEventListener('change', (e) => { state.from = e.target.value; state.offset = 0; reloadView(); });
    $('fTo').addEventListener('change', (e) => { state.to = e.target.value; state.offset = 0; reloadView(); });
    $('clearBtn').addEventListener('click', () => { Object.assign(state, { q:'', status:'', assignedTo:'', treatment:'', from:'', to:'', offset:0 }); $('search').value=''; $('fStatus').value=''; $('fAssignee').value=''; $('fTreatment').value=''; $('fFrom').value=''; $('fTo').value=''; reload(); });
    $('viewBoard').addEventListener('click', () => setView('board'));
    $('viewTable').addEventListener('click', () => setView('table'));
    $('refreshBtn').addEventListener('click', reload);
    $('prevBtn').addEventListener('click', () => { state.offset = Math.max(0, state.offset - state.limit); loadLeads(); });
    $('nextBtn').addEventListener('click', () => { state.offset += state.limit; loadLeads(); });
    $('logoutBtn').addEventListener('click', () => { localStorage.removeItem('tbf_token'); localStorage.removeItem('tbf_user'); location.replace('/admin/login'); });
    $('closeDrawer').addEventListener('click', closeDrawer);
    $('scrim').addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

    if ($('userInfo')) $('userInfo').textContent = ME.name ? `${ME.name} · ${ME.role}` : (ME.email || '');
    if ((ME.role === 'admin' || ME.role === 'manager') && $('navUsers')) $('navUsers').hidden = false;

    // go
    (async () => {
      try {
        await loadAgents();
        // reflect the saved view in the toggle before first paint
        $('viewBoard').classList.toggle('is-on', state.view === 'board');
        $('viewTable').classList.toggle('is-on', state.view === 'table');
        $('board').hidden = state.view !== 'board';
        $('tableWrap').hidden = state.view !== 'table';
        $('pager').hidden = state.view !== 'table';
        $('fStatus').hidden = state.view !== 'table';
        await reload();
        $('loading').hidden = true; $('dash').hidden = false;
        const wantLead = new URLSearchParams(location.search).get('lead');
        if (wantLead) {
          if (!leads.find((l) => l.id === wantLead)) { const j = await api('/api/admin/leads/' + wantLead); if (j.ok) leads.unshift(j.lead); }
          if (leads.find((l) => l.id === wantLead)) openDetail(wantLead);
        }
      }
      catch (e) { if (e.message !== 'unauth') { $('loading').textContent = 'Could not reach the API. Is the server running?'; } }
    })();
  </script>
</Admin>
