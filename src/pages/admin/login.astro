---
import Admin from '../../layouts/Admin.astro';
import { site } from '../../site.config';
---
<Admin title="Sign in">
  <main class="login">
    <form class="login__card" id="loginForm" novalidate>
      <img class="login__mark" src="/logo/icon-512.png" alt="" width="52" height="52" />
      <span class="eyebrow">{site.name}</span>
      <h1 class="login__h">Team dashboard</h1>
      <p class="login__sub">Sign in to manage enquiries and appointments.</p>

      <label class="login__field">
        <span>Email</span>
        <input type="email" name="email" autocomplete="username" required />
      </label>
      <label class="login__field">
        <span>Password</span>
        <input type="password" name="password" autocomplete="current-password" required />
      </label>

      <p class="login__err" id="err" role="alert" hidden></p>

      <button type="submit" class="btn btn--primary login__btn" id="submit">Sign in</button>
      <a href="/" class="login__back">&larr; Back to the site</a>
    </form>
  </main>

  <script define:vars={{ apiBase: site.apiBase }}>
    if (localStorage.getItem('tbf_token')) location.replace('/admin/');

    const form = document.getElementById('loginForm');
    const err = document.getElementById('err');
    const submit = document.getElementById('submit');
    const showErr = (m) => { err.textContent = m; err.hidden = false; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      submit.disabled = true;
      submit.textContent = 'Signing in…';
      try {
        const res = await fetch(apiBase + '/api/auth/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: form.email.value.trim(), password: form.password.value }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          showErr(
            data.error === 'invalid_credentials' ? 'That email or password is not right.'
            : data.error === 'auth_not_configured' ? 'The dashboard login is not set up yet (ADMIN_EMAIL / ADMIN_PASSWORD).'
            : data.error === 'too_many_attempts' ? 'Too many attempts. Try again in a few minutes.'
            : 'Sign in failed. Please try again.');
          return;
        }
        localStorage.setItem('tbf_token', data.token);
        localStorage.setItem('tbf_user', JSON.stringify(data.user || {}));
        location.replace('/admin/');
      } catch {
        showErr('Could not reach the server. Is the API running?');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Sign in';
      }
    });
  </script>

  <style>
    .login{display:grid;place-items:center;min-height:100vh;padding:var(--s4)}
    .login__card{
      width:100%;max-width:24rem;display:grid;gap:.6rem;
      background:var(--surface-raised);border:1px solid var(--line);border-top:3px solid var(--accent);
      padding:clamp(var(--s4),5vw,var(--s6));
      box-shadow:0 40px 80px -50px rgba(11,79,89,.5)
    }
    .login__mark{width:48px;height:48px;margin-bottom:.4rem}
    .login__h{font-family:'Playfair Display',serif;font-weight:400;font-size:1.9rem;color:var(--deep-teal);letter-spacing:-.018em;margin-top:.3rem}
    .login__sub{font-size:.8125rem;color:var(--text-muted);margin-bottom:var(--s2)}
    .login__field{display:grid;gap:.4rem;margin-top:.3rem}
    .login__field span{font-size:.6875rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--deep-teal)}
    .login__field input{
      font-family:inherit;font-size:.9375rem;color:var(--charcoal);
      background:var(--surface-raised);border:1px solid var(--line);border-radius:0;
      padding:.8rem .9rem;min-height:46px
    }
    .login__field input:focus-visible{border-color:var(--ocean-teal);outline:2px solid rgba(22,124,136,.28);outline-offset:0}
    .login__err{font-size:.8125rem;color:#A0392E;background:#FBECEA;border-left:2px solid #A0392E;padding:.6rem .8rem;margin-top:.4rem}
    .login__btn{width:100%;margin-top:var(--s2)}
    .login__back{font-size:.75rem;color:var(--text-muted);text-decoration:none;margin-top:.6rem;text-align:center}
    .login__back:hover{color:var(--deep-teal)}
  </style>
</Admin>
