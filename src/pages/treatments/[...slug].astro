---
import Base from '../../layouts/Base.astro';
import TreatmentCard from '../../components/TreatmentCard.astro';
import TreatmentVideo from '../../components/TreatmentVideo.astro';
import TreatmentGallery, { type GalleryPhoto } from '../../components/TreatmentGallery.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import LeadForm from '../../components/LeadForm.astro';
import { site, messengerLink, telLink } from '../../site.config';
import MessengerIcon from '../../components/MessengerIcon.astro';
import { combosFor } from '../../combos';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('treatments', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// Same group first (Skin next to Skin, Hair next to Hair), then display order.
const related = (await getCollection('treatments', ({ data }) => !data.draft))
  .filter((t) => t.id !== entry.id)
  .sort((a, b) => {
    const s = (x: typeof a) => (x.data.group === d.group ? 0 : 1);
    return s(a) - s(b) || a.data.order - b.data.order;
  })
  .slice(0, 3);

// Blog posts that mention this treatment (build-time fetch, fails soft).
import { fetchPosts } from '../../lib/blog';
const { posts } = await fetchPosts(`?related=${entry.id}&limit=2`);

// Full treatment list for the booking dropdown, this treatment pre-selected.
const treatmentNames = (await getCollection('treatments', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => t.data.title);

const peso = (n: number) => '₱' + n.toLocaleString('en-PH');
// Combos that include this treatment (empty for treatments in no combo).
const myCombos = combosFor(entry.id);
const facts = [
  { k: 'First visit', v: d.promoPrice ? `from ${peso(d.promoPrice)}` : (d.priceFrom ? `${peso(d.priceFrom)} / ${d.priceUnit}` : 'On consultation') },
  { k: 'Session',  v: d.duration },
  { k: 'Course',   v: d.course },
  { k: 'Downtime', v: d.downtime },
];

// Two showcase images for the experience band. Content can supply its own via
// `gallery:` in the frontmatter; otherwise fall back to curated clinic
// photography per group — never repeating the hero image.
const FALLBACK_GALLERY: Record<string, string[]> = {
  Skin:     ['/img/t-treatment.jpg', '/img/f-expert.jpg', '/img/t-skin.jpg'],
  Hair:     ['/img/t-clinician.jpg', '/img/t-care.jpg', '/img/f-expert.jpg'],
  Wellness: ['/img/t-lobby.jpg', '/img/t-leaf.jpg', '/img/t-reception.jpg'],
};
const pool = d.gallery.length ? [...d.gallery, ...FALLBACK_GALLERY[d.group]] : FALLBACK_GALLERY[d.group];
const gallery = [...new Set(pool)].filter((i) => i !== d.image).slice(0, 2);
const heroAlt = d.imageAlt ?? `${d.title} at ${site.name}`;
// Button-length name: drops a trailing "(…)" or "— …", e.g. "HIFU (High-Intensity…)" → "HIFU".
// Names still too long for one line on a phone fall back to a generic label.
const trimmed = d.title.replace(/\s*\(.*\)\s*$/, '').replace(/\s+[—–-]\s+.*$/, '');
const shortTitle = trimmed.length <= 22 ? trimmed : 'this treatment';

// Photo gallery. Content can supply its own via `photos:`; until then it shows
// the treatment photo plus real clinic photography not already used on this page.
const CLINIC_PHOTOS: GalleryPhoto[] = [
  { src: '/img/f-reception.jpg', alt: 'The Better Face reception: a marble front desk, white tiled floor and tall glass windows onto the street', caption: 'Reception' },
  { src: '/img/t-care.jpg', alt: 'A clinician in teal scrubs treating a client lying back with a towel wrap', caption: 'In the treatment room' },
  { src: '/img/f-brand-wall.jpg', alt: 'The gold TBF logo and tagline on dark teal panelling above the front desk', caption: 'The clinic' },
  { src: '/img/t-clinician.jpg', alt: 'A masked clinician in a white coat treating a client with a handheld device', caption: 'Our clinicians' },
  { src: '/img/t-lobby.jpg', alt: 'The lobby, with the gold logo above a curved front desk', caption: 'The lobby' },
  { src: '/img/t-coat.jpg', alt: "The TBF logo embroidered on a clinician's white coat", caption: 'The details' },
];
const own: GalleryPhoto[] = d.photos.map((p) =>
  typeof p === 'string' ? { src: p, alt: `${d.title} at ${site.name}` } : { alt: `${d.title} at ${site.name}`, ...p });
const photos: GalleryPhoto[] = own.length ? own : [
  ...(d.image ? [{ src: d.image, alt: heroAlt, caption: d.title }] : []),
  ...CLINIC_PHOTOS.filter((p) => !gallery.includes(p.src)),
].slice(0, 5);
---
<Base
  title={d.seoTitle}
  description={d.metaDescription}
  path={`/treatments/${entry.id}/`}
  ogImage={d.image}
  ogImageAlt={heroAlt}
  schemaType="service"
  serviceName={d.title}
  serviceDescription={d.summary}
  serviceType={d.category}
  price={d.priceFrom}
  viewContent={{ name: d.title, category: d.group, id: entry.id }}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Treatments', path: '/treatments/' },
    { name: d.title, path: `/treatments/${entry.id}/` },
  ]}
>
  <!-- ══════════════ HERO ══════════════ -->
  <section class="thero">
    <div class="thero__text">
      <div class="thero__inner">
        <nav class="crumbs" aria-label="Breadcrumb" data-reveal>
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/treatments/">Treatments</a><span aria-hidden="true">/</span>
          <a href={`/treatments/#${d.group.toLowerCase()}`}>{d.group}</a>
        </nav>
        <span class="eyebrow" data-reveal>{d.category}</span>
        <h1 class="thero__h" data-reveal data-reveal-delay="1">{d.title}</h1>
        <hr class="rule" data-reveal data-reveal-delay="1" />
        <p class="lede" data-reveal data-reveal-delay="2">{d.summary}</p>
        <div class="thero__cta" data-reveal data-reveal-delay="3">
          <a href="#book" class="btn btn--primary" data-ev="book_click" data-loc="treatment">Book {shortTitle}</a>
          <a href={messengerLink} class="btn btn--ghost" data-ev="whatsapp_click" data-loc="treatment" target="_blank" rel="noopener"><MessengerIcon />Messenger</a>
        </div>
        <p class="disclaimer thero__dis" data-reveal data-reveal-delay="3">
          All treatments require a consultation. Results vary between individuals.
        </p>
      </div>
    </div>

    <div class="thero__media zoom">
      {d.image
        ? <img src={d.image} alt={heroAlt} width="900" height="1200" fetchpriority="high" decoding="async" />
        : <div class="thero__ph" aria-hidden="true"></div>}
    </div>
  </section>

  <!-- ══════════════ FACTS STRIP ══════════════ -->
  <section class="facts inverse">
    <div class="wrap facts__in">
      {facts.map((f) => (
        <div class="facts__i">
          <span class="facts__k">{f.k}</span>
          <span class="facts__v">{f.v}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════ BODY ══════════════ -->
  <section class="section">
    <div class="wrap tbody">
      <article class="prose" data-reveal><Content /></article>

      <aside class="aside">
        {d.promoPrice && (
          <div class="aside__price" data-reveal>
            <span class="eyebrow">First-visit promo</span>
            <p class="aside__priceline">
              <span class="aside__now">{peso(d.promoPrice)}</span>
              {d.promoScope && <span class="aside__unit">{d.promoScope}</span>}
            </p>
            <p class="aside__promo-note">One promo per treatment · first visit only</p>
            {d.priceFrom && (
              <p class="aside__price-reg">Regular <s>{peso(d.priceFrom)}</s> / {d.priceUnit} · packages save 25–50%</p>
            )}
          </div>
        )}
        <div class="aside__card" data-reveal data-reveal-delay="1">
          <span class="eyebrow">Book</span>
          <h2 class="aside__h">Start with a consultation</h2>
          <p class="small">
            Forty-five minutes with a clinician. We assess you, explain the options
            and give you a written plan and price.
          </p>
          <a href="#book" class="btn btn--primary aside__btn" data-ev="book_click" data-loc="treatment_aside">Book Free Consultation</a>
          <a href={telLink} class="aside__tel" data-ev="call_click" data-loc="treatment_aside">or call {site.phoneDisplay}</a>
        </div>

        {posts.length > 0 && (
          <div class="aside__rel" data-reveal data-reveal-delay="2">
            <span class="eyebrow">Read first</span>
            {posts.map((p) => (
              <a href={`/journal/${p.slug}/`} class="aside__link">{p.title}<i aria-hidden="true">→</i></a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- ══════════════ EXPERIENCE (two showcase images) ══════════════ -->
  <section class="section tgal">
    <div class="wrap tgal__grid">
      <figure class="tgal__img tgal__img--a zoom" data-reveal>
        <img src={gallery[0]} alt={`${d.title} at ${site.name}`} width="520" height="650" loading="lazy" decoding="async" />
        {/* Clinic-photo captions; hidden once a treatment supplies its own `gallery:` photos. */}
        {!d.gallery.length && <figcaption class="tgal__cap">In the treatment room</figcaption>}
      </figure>
      <div class="tgal__in" data-reveal data-reveal-delay="1">
        <span class="eyebrow">The experience</span>
        <h2 class="tgal__h">Clinical standards, in a calm room.</h2>
        <p class="tgal__p">
          {d.title} is delivered in a private treatment room at our {site.address.region}
          clinic, by a clinician who has assessed you first — never off a script, never rushed. You will know what
          is happening at every step, and exactly what to do when you get home.
        </p>
        <ul class="tgal__pts">
          <li>Delivered by a licensed clinician</li>
          <li>Assessed at consultation before anything is booked</li>
          <li>Aftercare and a review point included</li>
        </ul>
      </div>
      <figure class="tgal__img tgal__img--b zoom" data-reveal data-reveal-delay="2">
        <img src={gallery[1]} alt={`Inside ${site.name}, where ${d.title} is performed`} width="520" height="650" loading="lazy" decoding="async" />
        {!d.gallery.length && <figcaption class="tgal__cap">The Better Face clinic</figcaption>}
      </figure>
    </div>
  </section>

  <!-- ══════════════ HOW YOUR VISIT WORKS (shared care standard) ══════════════ -->
  <section class="section steps">
    <div class="wrap">
      <div class="sec-head steps__head" data-reveal>
        <div>
          <span class="eyebrow">Every treatment, every time</span>
          <h2>How your visit works</h2>
        </div>
      </div>
      <ol class="steps__list">
        <li data-reveal>
          <span class="steps__n">1</span>
          <h3 class="steps__h">Assessment</h3>
          <p>We look at your skin or scalp and your history, and confirm {shortTitle} is right for you — or recommend something that is.</p>
        </li>
        <li data-reveal data-reveal-delay="1">
          <span class="steps__n">2</span>
          <h3 class="steps__h">Plan &amp; consent</h3>
          <p>We explain what to expect and answer your questions. You give written consent before anything begins.</p>
        </li>
        <li data-reveal data-reveal-delay="2">
          <span class="steps__n">3</span>
          <h3 class="steps__h">Before photos</h3>
          <p>With your permission, so you have an honest record to measure your own progress against.</p>
        </li>
        <li data-reveal data-reveal-delay="3">
          <span class="steps__n">4</span>
          <h3 class="steps__h">Your treatment</h3>
          <p>Carried out by a trained, licensed provider in a private, hygienic suite, checking your comfort throughout.</p>
        </li>
        <li data-reveal data-reveal-delay="4">
          <span class="steps__n">5</span>
          <h3 class="steps__h">Aftercare</h3>
          <p>Soothing care on the day, sun protection where it matters, and clear home-care advice to take with you.</p>
        </li>
        <li data-reveal data-reveal-delay="5">
          <span class="steps__n">6</span>
          <h3 class="steps__h">Follow-up</h3>
          <p>We record what was done and when to return, so each visit builds on the last.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ══════════════ VIDEO ══════════════ -->
  <TreatmentVideo video={d.video} poster={d.videoPoster ?? d.image} title={d.title} />

  <!-- ══════════════ GALLERY ══════════════ -->
  <TreatmentGallery photos={photos} title={d.title} heading={`${d.title}, up close`} />

  <!-- ══════════════ SUITABILITY ══════════════ -->
  <section class="section">
    <div class="wrap suit">
      <div class="suit__col" data-reveal>
        <span class="eyebrow">Suitable for</span>
        <ul class="suit__list suit__list--yes">
          {d.suitableFor.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="suit__col" data-reveal data-reveal-delay="1">
        <span class="eyebrow">Not suitable for</span>
        <ul class="suit__list suit__list--no">
          {d.notSuitableFor.map((s) => <li>{s}</li>)}
        </ul>
        <p class="small suit__note">
          If any of these apply to you we will say so at consultation and recommend
          something else — or nothing.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════ BEFORE / AFTER ══════════════ -->
  <BeforeAfter pairs={d.beforeAfter} title={d.title} />

  <!-- ══════════════ SAVE WITH A COMBO (cross-sell) ══════════════ -->
  {myCombos.length > 0 && (
    <section class="section combos">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div>
            <span class="eyebrow">Better together</span>
            <h2>Save with a combo</h2>
          </div>
          <a href={messengerLink} class="sec-head__link" target="_blank" rel="noopener" data-ev="whatsapp_click" data-loc="treatment_combo">Ask about combos<i aria-hidden="true">→</i></a>
        </div>
        <p class="combos__intro">Pair {shortTitle} with another treatment in one visit for one lower price. First visit only, one combo per client — it cannot be stacked with a single-treatment first-visit offer.</p>
        <div class="combos__grid">
          {myCombos.map((c, i) => (
            <div class="combo" data-reveal data-reveal-delay={String(i % 3)}>
              <h3 class="combo__name">{c.name}</h3>
              <p class="combo__tag">{c.tagline}</p>
              <ul class="combo__items">
                {c.items.map((it) => (
                  <li class={it.slug === entry.id ? 'is-this' : ''}>
                    {it.slug && it.slug !== entry.id
                      ? <a href={`/treatments/${it.slug}/`}>{it.label}</a>
                      : <span>{it.label}{it.slug === entry.id && <em> · this treatment</em>}</span>}
                    <span class="combo__ip">{peso(it.price)}</span>
                  </li>
                ))}
              </ul>
              <div class="combo__price">
                <span class="combo__now">{peso(c.price)}</span>
                <span class="combo__was">worth {peso(c.value)}</span>
                <span class="combo__save">save {peso(c.value - c.price)}</span>
              </div>
              <p class="combo__best"><strong>Best for</strong> · {c.bestFor}</p>
              <a href={messengerLink} class="btn btn--primary combo__btn" target="_blank" rel="noopener" data-ev="book_click" data-loc="treatment_combo">Book this combo</a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════ BOOK (this treatment pre-selected) ══════════════ -->
  <section class="tbook inverse" id="book">
    <div class="wrap tbook__in">
      <div class="tbook__copy" data-reveal>
        <span class="eyebrow">Book {d.title}</span>
        <h2 class="tbook__h">A consultation, not a sales appointment.</h2>
        <p class="lede">
          Leave your details and we will call you back — usually the same day. Your
          enquiry comes through with <strong>{d.title}</strong> already noted, so we
          come to the call prepared.
        </p>
        <ul class="tbook__pts">
          <li>A written plan and price before you decide</li>
          <li>Delivered by a licensed clinician</li>
          <li>We say no when a treatment is not right for you</li>
        </ul>
        <div class="tbook__alt">
          <a href={messengerLink} class="btn btn--wa" data-ev="whatsapp_click" data-loc="treatment_book" target="_blank" rel="noopener"><MessengerIcon />Messenger</a>
          <p class="tbook__tel"><span>or call <a href={telLink} data-ev="call_click" data-loc="treatment_book">{site.phoneDisplay}</a></span></p>
        </div>
      </div>

      <div class="tbook__form light-island" data-reveal data-reveal-delay="1">
        <h3 class="tbook__ft">Request your consultation</h3>
        <p class="tbook__fsub">{d.title} is pre-selected — change it below if you like.</p>
        <LeadForm source={`treatment:${entry.id}`} treatments={treatmentNames} preselect={d.title} compact={true} />
      </div>
    </div>
  </section>

  <!-- ══════════════ RELATED ══════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <div>
          <span class="eyebrow">Also in {d.group}</span>
          <h2>Often considered alongside</h2>
        </div>
        <a href="/treatments/" class="sec-head__link">All treatments<i aria-hidden="true">→</i></a>
      </div>
      <div class="grid g-2 g-3 rel">
        {related.map((t, i) => (
          <div data-reveal data-reveal-delay={String(i)}>
            <TreatmentCard
              href={`/treatments/${t.id}/`}
              title={t.data.title}
              summary={t.data.summary}
              category={t.data.category}
              priceFrom={t.data.priceFrom}
              promoPrice={t.data.promoPrice}
              duration={t.data.duration}
              image={t.data.image}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs{display:flex;flex-wrap:wrap;gap:.5em;font-size:.5625rem;letter-spacing:.2em;
    text-transform:uppercase;font-weight:600;color:var(--text-muted);margin-bottom:var(--s4)}
  .crumbs a{color:var(--text-muted);text-decoration:none}
  .crumbs a:hover{color:var(--deep-teal);text-decoration:underline}

  /* ---------------- HERO ---------------- */
  .thero{display:grid;background:var(--surface-raised)}
  @media (min-width:900px){ .thero{grid-template-columns:50fr 50fr;min-height:clamp(500px,70vh,760px)} }
  .thero__text{display:flex;align-items:center;padding:var(--s6) var(--gutter)}
  @media (min-width:900px){
    .thero__text{
      padding:var(--s7) var(--s6) var(--s7)
              max(var(--gutter),calc((100vw - var(--page-max)) / 2 + var(--gutter)));
    }
  }
  .thero__inner{max-width:34rem}
  .thero__h{margin-top:.7rem}
  .thero__cta{display:flex;flex-wrap:wrap;gap:var(--s2);margin-top:var(--s4)}
  .thero__dis{margin-top:var(--s3)}
  .thero__media{position:relative;min-height:52vh;background:var(--light-teal);overflow:hidden}
  .thero__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .thero__ph{width:100%;height:100%;background:linear-gradient(140deg,var(--light-teal),var(--blush))}
  @media (min-width:900px){ .thero__media{min-height:0} }

  /* ---------------- FACTS ---------------- */
  .facts__in{display:grid;grid-template-columns:1fr 1fr;padding-block:var(--s2)}
  @media (min-width:800px){ .facts__in{grid-template-columns:repeat(4,1fr)} }
  .facts__i{display:grid;gap:.45rem;padding:var(--s3) var(--s3) var(--s3) 0}
  @media (min-width:800px){
    .facts__i + .facts__i{padding-left:var(--s4);border-left:1px solid rgba(201,166,107,.4)}
  }
  .facts__k{font-size:.5625rem;letter-spacing:.24em;text-transform:uppercase;font-weight:700;color:var(--champagne)}
  .facts__v{font-family:'Playfair Display',serif;font-size:1.2rem;line-height:1.3;
    letter-spacing:-.012em;color:var(--ivory)}

  /* ---------------- SUITABILITY ---------------- */
  .suit{display:grid;gap:var(--s5)}
  @media (min-width:800px){ .suit{grid-template-columns:1fr 1fr;gap:var(--s6)} }
  .suit__list{list-style:none;padding:0;margin-top:var(--s3);display:grid}
  .suit__list li{position:relative;padding:.95rem 0 .95rem 2rem;font-size:.9375rem;line-height:1.7;
    border-bottom:1px solid var(--line)}
  .suit__list li:first-child{border-top:1px solid var(--line)}
  .suit__list li::before{position:absolute;left:0;top:.95rem;font-size:.9rem;line-height:1.7}
  .suit__list--yes li::before{content:'✓';color:var(--ocean-teal)}
  .suit__list--no li::before{content:'—';color:#A06A5E}
  .suit__note{margin-top:var(--s3)}

  /* ---------------- EXPERIENCE GALLERY ---------------- */
  .tgal{overflow:hidden;background:var(--surface-raised)}
  .tgal__grid{display:grid;gap:var(--s4);align-items:center}
  .tgal__in{max-width:32rem;margin-inline:auto;text-align:center;order:-1}
  .tgal__h{margin-top:.7rem;font-size:clamp(1.5rem,1.1rem + 1.4vw,2.1rem)}
  .tgal__p{font-size:.9375rem;line-height:1.85;color:var(--text-muted);margin-top:var(--s3)}
  .tgal__pts{list-style:none;padding:0;margin-top:var(--s4);display:grid;gap:.6rem;justify-items:center}
  .tgal__pts li{position:relative;padding-left:1.5rem;font-size:.8125rem;line-height:1.5;color:var(--charcoal)}
  .tgal__pts li::before{content:'✓';position:absolute;left:0;color:var(--ocean-teal);font-weight:700}
  .tgal__img{margin:0}
  .tgal__img img{width:100%;aspect-ratio:4/5;object-fit:cover;background:var(--light-teal)}
  .tgal__cap{
    margin-top:.65rem;font-size:.5625rem;letter-spacing:.22em;text-transform:uppercase;
    font-weight:700;color:var(--text-muted);text-align:center
  }
  @media (max-width:899px){
    .tgal__grid{grid-template-columns:1fr 1fr;gap:var(--s3)}
    .tgal__in{grid-column:1 / -1;margin-bottom:var(--s2)}
  }
  @media (min-width:900px){
    .tgal__grid{grid-template-columns:minmax(220px,1fr) minmax(0,2fr) minmax(220px,1fr);gap:var(--s6);padding-block:var(--s3)}
    .tgal__in{order:0}
    .tgal__img{width:100%;max-width:320px}
    .tgal__img--a{justify-self:end;transform:translateY(5%)}
    .tgal__img--b{justify-self:start;transform:translateY(-5%)}
  }

  /* ---------------- BODY ---------------- */
  .tbody{display:grid;gap:var(--s5)}
  @media (min-width:900px){ .tbody{grid-template-columns:minmax(0,1fr) 330px;gap:var(--s6);align-items:start} }

  .prose{max-width:66ch}
  .prose :global(h2){font-size:1.7rem;margin-top:var(--s5);margin-bottom:var(--s2)}
  .prose :global(h2:first-child){margin-top:0}
