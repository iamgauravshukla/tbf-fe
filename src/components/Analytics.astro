---
// Nothing loads unless an ID is set in src/site.config.ts, so development and
// pre-launch stay fast and cookie-free.
//
// EVENT MAP — one GA4 event per interaction, mapped to a Meta standard event
// where a meaningful one exists. GA4 name → Meta event:
//   book_click      → InitiateCheckout header | hero | mobile_bar | treatment | …
//                     (Schedule is NOT fired on a click — only on a completed
//                      booking, from BookingForm.astro on the saved response.)
//   call_click      → Contact         header | footer | mobile_bar | landing | auto
//   whatsapp_click  → Contact         mobile_bar | landing | treatment | auto
//   email_click     → Contact         contact | auto
//   view_item       → ViewContent     treatment + landing pages (from a meta tag)
//   book_page_view  → —               every /book/ page load, tagged with the
//                     first-touch campaign/source/medium/ad-creative (GA only) —
//                     the ad-funnel entry: count Meta visits to /book/ and break
//                     the funnel down by campaign + utm_content creative.
//   video_play      → —               treatment (GA only)
//   form_start      → —               first interaction with a lead form (GA only)
//   form_submit     → —               real submit event, carries the treatment (GA only)
//   page_not_found  → —               /404 (GA only)
//   generate_lead   → Lead            once per session on /thank-you/ — THE conversion
//
// "auto" = the fallback in the click listener below: any tel:, m.me (Messenger),
// wa.me or mailto: link with no data-ev (legal pages, links inside blog posts)
// still tracks, so new pages are covered without annotation.
//
// Meta base code fires PageView on every load (MPA — real navigations, so no
// SPA double-count). ViewContent + Lead carry content_name so Events Manager
// and dynamic-ads audiences can break down by treatment.
//
// BOOKING FORM (/book/…): a completed booking fires GA4 `generate_lead`
// (method:'booking') and Meta `Schedule` — the standard event for a booked
// appointment — directly from BookingForm.astro. It is a separate funnel from
// the enquiry Lead below (it never passes through /thank-you/), so the two
// never double-count. First-touch utm_* / fbclid (captured by the script just
// below) are stamped onto the booking so the dashboard shows its campaign.
//
// In the GA4 UI: mark generate_lead as the key event; in Meta Events Manager
// mark Lead as a conversion (and optionally Contact). Leave GA4 Enhanced
// Measurement on for scroll + outbound. Do NOT make form_submit a conversion
// on either platform: it fires before the API accepts the lead, so Lead on
// /thank-you/ is the single source of truth and avoids over-reporting spend.
import { site } from '../site.config';
const { ga4, metaPixel, apiBase } = site;
---
<!-- First-touch attribution — captured on every page, independent of GA4/Pixel,
     so the booking form can record which campaign the visitor came from even
     when the pixels are off (e.g. on localhost). Stored once per visit, so the
     ORIGINAL landing campaign survives later param-less navigation. -->
<script is:inline>
  (function () {
    try {
      var KEY = 'tbf_attr';
      if (sessionStorage.getItem(KEY)) return; // first touch only
      var p = new URLSearchParams(location.search);
      var keys = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','utm_id','fbclid','gclid'];
      var attr = {}, got = false;
      keys.forEach(function (k) { var v = p.get(k); if (v) { attr[k] = v.slice(0, 200); got = true; } });
      if (got) {
        attr.landing = location.pathname;
        if (document.referrer) attr.ref = document.referrer.slice(0, 200);
        sessionStorage.setItem(KEY, JSON.stringify(attr));
      }
    } catch (e) {}
  })();
</script>

<!-- First-party, cookieless page-view beacon → our own /api/track, so the
     dashboard's Visitors view counts every visitor, including the Meta ad clicks
     that ad blockers / cookie refusals hide from GA4 and the Pixel. Production
     host only (same gate as GA4/Pixel). No cookie, no IP, no PII: a per-tab
     session id in sessionStorage, the path, the referring host, the first-touch
     campaign and a coarse device class. sendBeacon = fire-and-forget, survives
     the page being closed, and (text/plain) needs no CORS preflight. -->
<script is:inline define:vars={{ apiBase }}>
  (function () {
    try {
      if (location.hostname !== 'www.thebetterface.com') return;
      if (!apiBase) return;
      var sid = sessionStorage.getItem('tbf_sid');
      var entry = false;
      if (!sid) {
        sid = (crypto.randomUUID ? crypto.randomUUID()
          : String(Date.now()) + Math.random().toString(16).slice(2));
        sessionStorage.setItem('tbf_sid', sid);
        entry = true; // the session's first page = its landing page
      }
      var attr = {};
      try { attr = JSON.parse(sessionStorage.getItem('tbf_attr') || '{}') || {}; } catch (e) {}
      var refHost = '';
      try {
        if (document.referrer) {
          var rh = new URL(document.referrer).hostname;
          if (rh && rh !== location.hostname) refHost = rh;
        }
      } catch (e) {}
      var ua = navigator.userAgent || '';
      var device = /iPad|Tablet|PlayBook|Silk|Android(?!.*Mobile)/i.test(ua) ? 'tablet'
        : /Mobi|Android|iPhone|iPod|Windows Phone/i.test(ua) ? 'mobile' : 'desktop';
      var payload = JSON.stringify({
        sid: sid,
        path: location.pathname,
        ref: refHost || undefined,
        source: attr.utm_source,
        medium: attr.utm_medium,
        campaign: attr.utm_campaign,
        content: attr.utm_content,
        device: device,
        entry: entry,
      });
      var url = apiBase + '/api/track';
      if (navigator.sendBeacon) navigator.sendBeacon(url, payload);
      else fetch(url, { method: 'POST', body: payload, keepalive: true, mode: 'cors' });
    } catch (e) {}
  })();
</script>
{ga4 && (
  <script is:inline define:vars={{ ga4 }}>
    // STRICT ALLOWLIST (same host gate as the Pixel below): GA4 loads on the
    // canonical production host ONLY. localhost, LAN, staging, previews and the
    // apex (pre-redirect) never load it, so dev / QA traffic can't pollute the
    // numbers you actually report on — /book/ visit counts, bounce / engagement
    // rate and the campaign breakdowns. Off-prod, window.gtag stays undefined,
    // which turns every send() below into a no-op (each is guarded by it).
    if (location.hostname === 'www.thebetterface.com') {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', ga4);
    }
  </script>
)}

{metaPixel && (
  <>
    <script is:inline define:vars={{ metaPixel }}>
      // STRICT ALLOWLIST: the Pixel loads on the canonical production host ONLY.
      // localhost, LAN, staging, previews and the apex (pre-redirect) never load
      // it, so no test traffic can ever reach the live dataset. Every fbq call on
      // the site is guarded by `if (window.fbq)`, so not initialising here
      // disables them all (PageView, Schedule, Contact, ViewContent) off-prod.
      if (location.hostname === 'www.thebetterface.com') {
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
        (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', metaPixel); fbq('track','PageView');
      }
    </script>
    <noscript set:html={`<img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=${metaPixel}&ev=PageView&noscript=1" />`} />
  </>
)}

{(ga4 || metaPixel) && (
  <script is:inline>
    (function () {
      function send(name, params) {
        if (window.gtag) window.gtag('event', name, params);
        if (window.fbq) {
          // Map to Meta STANDARD events so they're optimizable and show up in
          // Events Manager without custom setup. location rides as content_name.
          if (name === 'call_click' || name === 'whatsapp_click' || name === 'email_click')
            window.fbq('track', 'Contact', { method: name, content_name: params.location });
          else if (name === 'book_click')
            // A "Book" CTA click is the START of the booking journey, NOT a
            // booking. It must never fire Schedule — that is reserved for a
            // completed booking (fired from BookingForm on the saved response).
            window.fbq('track', 'InitiateCheckout', { content_name: params.location });
          // form_submit / form_start / video_play stay GA-only on purpose —
          // Lead on /thank-you/ is the one conversion (see header note).
        }
      }

      // ViewContent / view_item — per-page metadata set by the layout as a meta
      // tag. Fired on load (not on a click), so Meta can build "viewed HIFU"
      // retargeting audiences and match dynamic ads.
      function fireView() {
        var m = document.querySelector('meta[name="tbf:view-content"]');
        if (!m) return;
        var d; try { d = JSON.parse(m.getAttribute('content') || '{}'); } catch (e) { return; }
        if (!d || !d.name) return;
        if (window.gtag) window.gtag('event', 'view_item', {
          items: [{ item_id: d.id || d.name, item_name: d.name, item_category: d.category }],
        });
        if (window.fbq) window.fbq('track', 'ViewContent', {
          content_name: d.name,
          content_category: d.category,
          content_ids: d.id ? [d.id] : undefined,
          content_type: 'product',
        });
      }
      // Book-funnel entry — a dedicated GA4 event on every /book/ page load,
      // stamped with the first-touch campaign (utm_*) from tbf_attr. It lets GA4
      // count ad-driven booking-page visits and break the funnel
      // (book_page_view → book_click → generate_lead) down by campaign AND by ad
      // creative (utm_content) in a single Exploration — which the raw page_view
      // + session attribution can't do cleanly. Fired on load with no
      // engagement_time, so it never flips a session to "engaged": bounce rate
      // stays honest. GA-only (Meta already gets its PageView).
      function fireBookView() {
        if (!window.gtag) return;
        if (!/^\/book(\/|$)/.test(location.pathname)) return;
        var a = {};
        try { a = JSON.parse(sessionStorage.getItem('tbf_attr') || '{}') || {}; } catch (e) {}
        window.gtag('event', 'book_page_view', {
          page: location.pathname,
          campaign: a.utm_campaign,
          source: a.utm_source,
          medium: a.utm_medium,
          content: a.utm_content,
        });
      }

      function onReady() { fireView(); fireBookView(); }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady);
      else onReady();

      // One delegated listener for every CTA — annotated first, then the
      // automatic fallback for contact links that carry no data-ev.
      document.addEventListener('click', function (e) {
        if (!e.target || !e.target.closest) return;
        var el = e.target.closest('[data-ev], a[href]');
        if (!el) return;
        var name = el.getAttribute('data-ev');
        var loc  = el.getAttribute('data-loc');
        if (!name) {
          var href = el.getAttribute('href') || '';
          if (href.indexOf('tel:') === 0) name = 'call_click';
          else if (/m\.me|messenger\.com|wa\.me|api\.whatsapp\.com/.test(href)) name = 'whatsapp_click';
          else if (href.indexOf('mailto:') === 0) name = 'email_click';
          if (!name) return;
          loc = loc || 'auto';
        }
        if (name === 'form_submit') return; // tracked on the submit event below
        send(name, { location: loc || 'unknown', page: location.pathname });
      }, { passive: true });

      // Lead forms (marked with data-form-loc): form_start once per page on
      // the first interaction, form_submit only on the real submit event —
      // i.e. after native validation has passed, as the POST leaves the page.
      var started = false;
      document.addEventListener('focusin', function (e) {
        if (started || !e.target || !e.target.closest) return;
        var f = e.target.closest('form[data-form-loc]');
        if (!f) return;
        started = true;
        send('form_start', { location: f.getAttribute('data-form-loc'), page: location.pathname });
      });
      document.addEventListener('submit', function (e) {
        var f = e.target && e.target.closest ? e.target.closest('form[data-form-loc]') : null;
        if (!f) return;
        var t = f.elements && f.elements.treatment && f.elements.treatment.value;
        // Carry the chosen treatment to /thank-you/ so the Lead event there can
        // name it (thank-you is a static page reached via redirect, so it has
        // no other way to know what was enquired about).
        try { sessionStorage.setItem('tbf_lead_treatment', t || ''); } catch (e) {}
        send('form_submit', {
          location: f.getAttribute('data-form-loc'),
          treatment: t || '(none)',
          page: location.pathname,
        });
      });
    })();
  </script>
)}
