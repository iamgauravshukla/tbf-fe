---
// Client testimonials — a scroll-snap slider. Two cards per view on desktop,
// one on a phone. Arrows are progressive enhancement (revealed by script);
// touch and trackpad users swipe the rail directly, so it works with no JS.
interface Item { quote: string; name: string; meta?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<section class="tm section">
  <div class="wrap">
    <div class="tm__head">
      <div class="tm__intro" data-reveal>
        <span class="eyebrow">In their words</span>
        <h2 class="tm__h">What clients say</h2>
      </div>
      <div class="tm__arrows" hidden>
        <button type="button" class="tm__arrow" data-dir="-1" aria-label="Previous testimonials">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="tm__arrow" data-dir="1" aria-label="Next testimonials">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <div class="tm__rail" tabindex="0" role="region" aria-label="Client testimonials">
      {items.map((t, i) => (
        <figure class="tm__card" data-reveal data-reveal-delay={String(Math.min(i, 3))}>
          <span class="tm__mark" aria-hidden="true">“</span>
          <blockquote class="tm__q">{t.quote}</blockquote>
          <figcaption class="tm__by">
            <span class="tm__name">{t.name}</span>
            {t.meta && <span class="tm__meta">{t.meta}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('.tm').forEach(function (tm) {
      var rail = tm.querySelector('.tm__rail');
      var arrows = tm.querySelector('.tm__arrows');
      if (!rail || !arrows) return;
      var prev = arrows.querySelector('[data-dir="-1"]');
      var next = arrows.querySelector('[data-dir="1"]');
      arrows.hidden = false;

      function step() {
        var card = rail.querySelector('.tm__card');
        return card ? card.getBoundingClientRect().width + 24 : rail.clientWidth * 0.8;
      }
      function update() {
        var max = rail.scrollWidth - rail.clientWidth;
        if (prev) prev.disabled = rail.scrollLeft <= 2;
        if (next) next.disabled = max <= 2 || rail.scrollLeft >= max - 2;
      }
      arrows.addEventListener('click', function (e) {
        var b = e.target.closest('[data-dir]');
        if (!b) return;
        rail.scrollBy({ left: step() * Number(b.dataset.dir), behavior: 'smooth' });
      });
      rail.addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update, { passive: true });
      update();
    });
  })();
</script>

<style>
  .tm__head{display:flex;align-items:flex-end;justify-content:space-between;gap:var(--s4);margin-bottom:var(--s5)}
  .tm__h{margin-top:.7rem}

  .tm__arrows{display:none;gap:.6rem;flex:none}
  @media (min-width:760px){ .tm__arrows{display:flex} }
  .tm__arrow{
    width:46px;height:46px;display:grid;place-items:center;cursor:pointer;
    background:transparent;border:1px solid var(--line);border-radius:50%;
    color:var(--deep-teal);transition:background-color .25s,border-color .25s,color .25s
  }
  .tm__arrow svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
  .tm__arrow:hover{background:var(--deep-teal);border-color:var(--deep-teal);color:var(--ivory)}
  .tm__arrow:disabled{opacity:.3;cursor:default}
  .tm__arrow:disabled:hover{background:transparent;border-color:var(--line);color:var(--deep-teal)}

  /* rail: one card per view on phones, two from 760px up */
  .tm__rail{
    display:flex;gap:var(--s3);overflow-x:auto;overflow-y:hidden;overscroll-behavior-x:contain;
    scroll-snap-type:x mandatory;padding-bottom:var(--s1);scrollbar-width:none
  }
  .tm__rail::-webkit-scrollbar{display:none}
  .tm__rail:focus-visible{outline:2px solid var(--ocean-teal);outline-offset:4px}
  .tm__card{
    flex:0 0 100%;scroll-snap-align:start;
    display:flex;flex-direction:column;
    background:var(--surface-raised);border:1px solid var(--line);border-top:3px solid var(--accent);
    padding:var(--s4)
  }
  @media (min-width:760px){ .tm__card{flex-basis:calc(50% - var(--s3) / 2)} }
  @media (min-width:600px){ .tm__card{padding:var(--s5)} }

  .tm__mark{display:block;font-family:'Playfair Display',serif;font-size:4rem;line-height:.5;
    height:1.7rem;color:var(--champagne);opacity:.6}
  .tm__q{
    font-family:'Playfair Display',serif;font-style:italic;font-weight:400;
    font-size:clamp(1.15rem,1rem + .6vw,1.4rem);line-height:1.5;letter-spacing:-.012em;
    color:var(--deep-teal);margin-top:var(--s2);flex:1
  }
  .tm__by{margin-top:var(--s4);display:grid;gap:.2rem}
  .tm__name{font-size:.8125rem;font-weight:700;letter-spacing:.02em;color:var(--deep-teal)}
  .tm__meta{font-size:var(--f-micro);letter-spacing:.24em;text-transform:uppercase;font-weight:700;color:var(--champagne)}

  .tm__note{margin-top:var(--s4)}
</style>
