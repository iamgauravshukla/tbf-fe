---
import { site } from '../site.config';
import { resolveOgImage } from '../lib/og';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/treatments/pico-laser/" */
  path: string;
  /** Ad landing pages must not be indexed — see public/robots.txt */
  noindex?: boolean;
  ogImage?: string;
  /** Describes ogImage for screen readers on social cards. */
  ogImageAlt?: string;
  /** "article" on journal posts; everything else is a website page. */
  ogType?: 'website' | 'article';
  /** Journal posts only — emitted as article:published_time / modified_time. */
  published?: Date;
  modified?: Date;
}
const {
  title, description, path, noindex = false,
  ogImage, ogImageAlt = site.name,
  ogType = 'website', published, modified,
} = Astro.props;
const canonical = new URL(path, site.url).href;
// Absolute, verified URL. Falls back to site.ogImageDefault when the page's
// image is missing, empty, or not publicly reachable — never an empty tag.
const og = await resolveOgImage(ogImage);
// The page's alt describes its own image, not the fallback brand mark.
const ogAlt = og.fallback ? site.name : ogImageAlt;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
<meta name="description" content={description} />
<!-- A noindex page gets no canonical: "don't index this" plus "this is the
     preferred URL" is a contradictory pair of signals. -->
{noindex
  ? <meta name="robots" content="noindex,follow" />
  : <link rel="canonical" href={canonical} />}

<!-- Self-hosted fonts: preload only the two cuts above the fold.
     Preloading more than this delays first paint rather than helping it. -->
<link rel="preload" href="/fonts/playfair-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/instrument-sans-var.woff2" as="font" type="font/woff2" crossorigin />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og.url} />
{og.type && <meta property="og:image:type" content={og.type} />}
{og.width && <meta property="og:image:width" content={String(og.width)} />}
{og.height && <meta property="og:image:height" content={String(og.height)} />}
<meta property="og:image:alt" content={ogAlt} />
<meta property="og:locale" content={site.locale} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{(modified ?? published) && <meta property="article:modified_time" content={(modified ?? published)!.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og.url} />
<meta name="twitter:image:alt" content={ogAlt} />

<meta name="theme-color" content="#0B4F59" />
<link rel="icon" href="/logo/icon-512.png" type="image/png" />
<link rel="apple-touch-icon" href="/logo/icon-180.png" />
