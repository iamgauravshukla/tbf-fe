---
import { site } from '../site.config';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/treatments/pico-laser/" */
  path: string;
  /** Ad landing pages must not be indexed — see public/robots.txt */
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, path, noindex = false, ogImage = '/logo/logo-vertical.png' } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,follow" />}

<!-- Self-hosted fonts: preload only the two cuts above the fold.
     Preloading more than this delays first paint rather than helping it. -->
<link rel="preload" href="/fonts/playfair-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/instrument-sans-var.woff2" as="font" type="font/woff2" crossorigin />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:locale" content={site.locale} />
<meta name="twitter:card" content="summary_large_image" />

<meta name="theme-color" content="#0B4F59" />
<link rel="icon" href="/logo/icon-512.png" type="image/png" />
<link rel="apple-touch-icon" href="/logo/icon-180.png" />
