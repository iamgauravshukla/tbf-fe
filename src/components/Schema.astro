---
// JSON-LD. Google reads this to build the Maps panel and rich results.
// LocalBusiness is the one that matters most for "[treatment] near me".
//
// Everything is emitted as ONE @graph so the nodes reference each other by @id
// (page → website → business, service → provider) instead of repeating data.
import { site, hasAddress, hasGeo } from '../site.config';

interface Props {
  type?: 'home' | 'service' | 'article';
  /** Path of the current page, e.g. "/treatments/hifu/". */
  path?: string;
  serviceName?: string;
  serviceDescription?: string;
  /** Short category label, e.g. "Laser" — becomes Service.serviceType. */
  serviceType?: string;
  price?: number | null;
  /** Page's main image (treatment hero / article cover). */
  image?: string;
  breadcrumbs?: { name: string; path: string }[];
  article?: { title: string; description: string; date: Date; modified?: Date; author: string };
}
const { type = 'home', path = '/', serviceName, serviceDescription, serviceType, price, image, breadcrumbs = [], article } = Astro.props;

const abs = (p: string) => new URL(p, site.url).href;
const BUSINESS_ID = `${site.url}/#business`;
const WEBSITE_ID = `${site.url}/#website`;
const pageUrl = abs(path);

// MedicalBusiness is a subtype of LocalBusiness — more specific, and the right
// one for a clinic with qualified practitioners.
const business = {
  '@type': ['MedicalBusiness', 'HealthAndBeautyBusiness'],
  '@id': BUSINESS_ID,
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  url: abs('/'),
  telephone: site.phoneE164,
  email: site.email,
  // `image` is the clinic itself (reception), `logo` is the brand mark.
  image: abs(site.clinicImage),
  logo: abs('/logo/logo-vertical.png'),
  slogan: site.tagline,
  currenciesAccepted: 'PHP',
  areaServed: { '@type': 'AdministrativeArea', name: site.address.region },
  // Region and country are known; street, city and postcode are only
  // published once they are real (see hasAddress in site.config.ts).
  address: {
    '@type': 'PostalAddress',
    ...(hasAddress ? {
      streetAddress: site.address.street,
      addressLocality: site.address.locality,
      postalCode: site.address.postalCode,
    } : {}),
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  ...(hasGeo ? { geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng } } : {}),
  ...(hasAddress ? { hasMap: site.mapUrl } : {}),
  openingHoursSpecification: site.hoursSpec.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  sameAs: [site.social.facebook, site.social.instagram].filter(Boolean),
  // NOTE: aggregateRating is deliberately omitted. Do not add it until you
  // have real, verifiable reviews on the site — marking up ratings you cannot
  // evidence is a manual-action risk, not a shortcut.
};

const website = type === 'home' ? {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  url: abs('/'),
  name: site.name,
  inLanguage: site.language,
  publisher: { '@id': BUSINESS_ID },
} : null;

// A clinic's treatment is an offered Service (which may carry an Offer);
// MedicalProcedure has no `offers` property and describes the procedure in the
// abstract rather than this clinic's service.
const serviceLd = type === 'service' && serviceName ? {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: serviceName,
  description: serviceDescription,
  url: pageUrl,
  ...(serviceType ? { serviceType } : {}),
  ...(image ? { image: abs(image) } : {}),
  provider: { '@id': BUSINESS_ID },
  areaServed: { '@type': 'AdministrativeArea', name: site.address.region },
  ...(price ? {
    offers: {
      '@type': 'Offer',
      url: pageUrl,
      priceCurrency: 'PHP',
      priceSpecification: { '@type': 'PriceSpecification', minPrice: price, priceCurrency: 'PHP' },
    },
  } : {}),
} : null;

const articleLd = type === 'article' && article ? {
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: article.title,
  description: article.description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  inLanguage: site.language,
  image: abs(image || '/logo/logo-vertical.png'),
  datePublished: article.date.toISOString(),
  dateModified: (article.modified ?? article.date).toISOString(),
  author: { '@type': 'Person', name: article.author },
  publisher: { '@id': BUSINESS_ID },
} : null;

const crumbLd = breadcrumbs.length ? {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem', position: i + 1, name: b.name,
    item: abs(b.path),
  })),
} : null;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [business, website, serviceLd, articleLd, crumbLd].filter(Boolean),
};
---
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
