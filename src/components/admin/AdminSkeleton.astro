---
// Skeleton shown while a dashboard page authenticates and loads. Pages keep the
// #loading contract from the old text loader: hide it once data is in, or set
// textContent to an error message (which simply replaces the bones with text).
---
<div class="db-skel" id="loading" aria-busy="true" aria-label="Loading">
  <div class="sk-top">
    <span class="sk sk--rev sk-dot"></span>
    <span class="sk sk--rev sk-line" style="width:8rem"></span>
    <span class="sk-sp"></span>
    <span class="sk sk--rev sk-pill" style="width:4.5rem"></span>
    <span class="sk sk--rev sk-pill" style="width:4.5rem"></span>
    <span class="sk sk--rev sk-pill" style="width:4rem"></span>
    <span class="sk-sp"></span>
    <span class="sk sk--rev sk-pill" style="width:5.5rem"></span>
    <span class="sk sk--rev sk-pill" style="width:5.5rem"></span>
  </div>
  <div class="sk-main">
    <div class="sk-tiles">
      <span class="sk sk-tile"></span><span class="sk sk-tile"></span><span class="sk sk-tile"></span>
      <span class="sk sk-tile"></span><span class="sk sk-tile"></span><span class="sk sk-tile"></span>
    </div>
    <div class="sk-toolbar">
      <span class="sk sk-line" style="flex:1 1 16rem;height:2.4rem"></span>
      <span class="sk sk-line" style="width:8rem;height:2.4rem"></span>
      <span class="sk sk-pill" style="width:7rem;height:2.4rem;margin-left:auto"></span>
    </div>
    <div class="sk-card">
      <span class="sk sk-row" style="width:96%"></span>
      <span class="sk sk-row" style="width:88%"></span>
      <span class="sk sk-row" style="width:93%"></span>
      <span class="sk sk-row" style="width:81%"></span>
      <span class="sk sk-row" style="width:90%"></span>
      <span class="sk sk-row" style="width:66%"></span>
    </div>
  </div>
</div>
