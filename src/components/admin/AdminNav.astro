---
// Dashboard app-shell chrome: a left sidebar on desktop that becomes a slide-in
// drawer (with a top app-bar) on tablet/phone. Pages wire #userInfo /
// #logoutBtn / #refreshBtn in their own scripts; role-gated links (Blog, Team)
// are toggled here so every page gets them. Pages report a successful API
// roundtrip via window.tbfSynced() and the freshness line keeps itself current.
import { site } from '../../site.config';
interface Props { active: 'leads' | 'bookings' | 'analytics' | 'blog' | 'tasks' | 'team'; heading: string }
const { active, heading } = Astro.props;

const ICONS: Record<string, string> = {
  leads: '<path d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-8 1a3 3 0 1 0-3-3 3 3 0 0 0 3 3Zm0 2c-2.7 0-5 1.3-5 3.5V20h6"/><path d="M16 13c-3 0-6 1.5-6 4v3h12v-3c0-2.5-3-4-6-4Z"/>',
  bookings: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/>',
  analytics: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  tasks: '<path d="M4 6h16M4 12h16M4 18h10"/><path d="M19 15l2 2 3-4" transform="translate(-4 0)"/>',
  blog: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  team: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11"/>',
};

const links = [
  { key: 'leads', href: '/admin/', label: 'Leads' },
  { key: 'bookings', href: '/admin/bookings/', label: 'Bookings' },
  { key: 'analytics', href: '/admin/analytics/', label: 'Analytics' },
  { key: 'tasks', href: '/admin/tasks/', label: 'Tasks' },
  { key: 'blog', href: '/admin/blog/', label: 'Blog', id: 'navBlog', gated: true },
  { key: 'team', href: '/admin/users/', label: 'Team', id: 'navUsers', gated: true },
];
---
<!-- Mobile/tablet top app-bar -->
<header class="db-appbar">
  <button class="db-burger" id="navBurger" type="button" aria-label="Open menu" aria-controls="dbSide" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <h1 class="db-appbar__h">{heading}</h1>
  <div class="db-appbar__r">
    <button class="db-iconbtn" id="refreshBtn" type="button" aria-label="Refresh" title="Refresh">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v5h-5"/></svg>
    </button>
  </div>
</header>

<!-- Sidebar (persistent on desktop, drawer on mobile) -->
<aside class="db-side" id="dbSide" aria-label="Dashboard navigation">
  <div class="db-side__brand">
    <span class="db-logochip"><img src="/logo/mark-brand.png" alt="" width="30" height="30" /></span>
    <span class="db-side__name">{site.name}</span>
  </div>

  <nav class="db-sidenav" aria-label="Sections">
    {links.map((l) => (
      <a
        href={l.href}
        id={l.id}
        hidden={l.gated || undefined}
        class:list={['db-sidelink', { 'is-active': active === l.key }]}
      >
        <svg class="db-sidelink__i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[l.key]} />
        <span>{l.label}</span>
      </a>
    ))}
  </nav>

  <div class="db-side__foot">
    <div class="db-side__user">
      <span class="db-avatar" id="userAvatar" aria-hidden="true"></span>
      <span class="db-user" id="userInfo"></span>
    </div>
    <div class="db-side__btns">
      <button class="db-btn db-btn--ghost db-btn--side" id="refreshBtnSide" type="button">Refresh</button>
      <button class="db-btn db-btn--ghost db-btn--side" id="logoutBtn" type="button">Sign out</button>
    </div>
    <span class="db-sync" id="lastSync" hidden></span>
  </div>
</aside>

<div class="db-navscrim" id="navScrim" hidden></div>

<script is:inline>
  // Role-gated links (admins + managers).
  (function () {
    try {
      var u = JSON.parse(localStorage.getItem('tbf_user') || '{}');
      if (u.role === 'admin' || u.role === 'manager') {
        var b = document.getElementById('navBlog'); if (b) b.hidden = false;
        var t = document.getElementById('navUsers'); if (t) t.hidden = false;
      }
      // Avatar initials from the signed-in user.
      var av = document.getElementById('userAvatar');
      if (av && (u.name || u.email)) {
        var src = (u.name || u.email).trim();
        var parts = src.split(/\s+/);
        av.textContent = (parts[0] ? parts[0][0] : '') + (parts[1] ? parts[1][0] : '');
        av.textContent = av.textContent.toUpperCase() || src[0].toUpperCase();
      }
    } catch (e) { /* signed out — the page will redirect */ }
  })();

  // Mobile drawer open/close.
  (function () {
    var side = document.getElementById('dbSide');
    var scrim = document.getElementById('navScrim');
    var burger = document.getElementById('navBurger');
    if (!side || !burger) return;
    function open() { document.body.classList.add('is-navopen'); scrim.hidden = false; burger.setAttribute('aria-expanded', 'true'); }
    function close() { document.body.classList.remove('is-navopen'); scrim.hidden = true; burger.setAttribute('aria-expanded', 'false'); }
    function toggle() { document.body.classList.contains('is-navopen') ? close() : open(); }
    burger.addEventListener('click', toggle);
    if (scrim) scrim.addEventListener('click', close);
    side.addEventListener('click', function (e) { if (e.target.closest('a')) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  })();

  // The app-bar refresh button mirrors the sidebar one. Pages attach their
  // reload handler to #refreshBtn; forward sidebar clicks to it.
  (function () {
    var sideRefresh = document.getElementById('refreshBtnSide');
    var barRefresh = document.getElementById('refreshBtn');
    if (sideRefresh && barRefresh) sideRefresh.addEventListener('click', function () { barRefresh.click(); });
  })();

  // Data freshness: pages call window.tbfSynced() after each successful API
  // response; the label ages by itself.
  (function () {
    var stamp = 0;
    function paint() {
      var el = document.getElementById('lastSync');
      if (!el || !stamp) return;
      var s = Math.floor((Date.now() - stamp) / 1000);
      el.hidden = false;
      el.textContent = s < 10 ? 'Updated just now'
        : s < 60 ? 'Updated ' + s + 's ago'
        : s < 3600 ? 'Updated ' + Math.floor(s / 60) + ' min ago'
        : 'Updated ' + Math.floor(s / 3600) + ' h ago';
    }
    window.tbfSynced = function () { stamp = Date.now(); paint(); };
    setInterval(paint, 15000);
  })();
</script>
