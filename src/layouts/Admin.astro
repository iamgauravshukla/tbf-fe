---
// Dashboard shell — no public header/footer/mobile bar, no indexing. Reuses the
// brand tokens from global.css so the admin area still looks like TBF.
import '../styles/global.css';
import '../styles/admin.css';
import { site } from '../site.config';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · {site.name}</title>
    <link rel="icon" href="/logo/icon-512.png" type="image/png" />
  </head>
  <body class="adm">
    <slot />
    <style is:global>
      body.adm{background:var(--surface);min-height:100vh;color:var(--text)}
      .adm *{box-sizing:border-box}
    </style>
  </body>
</html>
