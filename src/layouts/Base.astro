---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Schema from '../components/Schema.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  title: string; description: string; path: string;
  noindex?: boolean; ogImage?: string; ogImageAlt?: string;
  schemaType?: 'home' | 'service' | 'article';
  serviceName?: string; serviceDescription?: string; serviceType?: string; price?: number | null;
  breadcrumbs?: { name: string; path: string }[];
  article?: { title: string; description: string; date: Date; modified?: Date; author?: string };
  /** Fires ViewContent (Meta) + view_item (GA4) on load — set on service/offer pages. */
  viewContent?: { name: string; category?: string; id?: string };
}
const p = Astro.props;
const isArticle = p.schemaType === 'article' && !!p.article;
---
<!doctype html>
<html lang={site.language}>
  <head>
    <Head title={p.title} description={p.description} path={p.path} noindex={p.noindex}
          ogImage={p.ogImage} ogImageAlt={p.ogImageAlt}
          ogType={isArticle ? 'article' : 'website'}
          published={isArticle ? p.article!.date : undefined}
          modified={isArticle ? p.article!.modified : undefined} />
    <Schema type={p.schemaType} path={p.path} serviceName={p.serviceName} serviceDescription={p.serviceDescription}
            serviceType={p.serviceType} price={p.price} image={p.ogImage}
            breadcrumbs={p.breadcrumbs} article={p.article} />
    {p.viewContent && <meta name="tbf:view-content" content={JSON.stringify(p.viewContent)} />}
    <Analytics />
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <!-- ~380 bytes, inline, no framework. The class is added by script, so
         anything with [data-reveal] renders visible if this never runs. -->
    <script is:inline>
      (function () {
        var m = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (m.matches || !('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js-reveal');
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });
        addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });
        });
      })();
    </script>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
